@{
    Layout = "_Layout";
    ViewData["Title"] = "รับชมวิดีโอ";
}

<section class="section section--banner">
    <div class="section__breadcrumb">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <span>ข่าวสารและประกาศ</span>
                </li>
                <li class="breadcrumb-item active">
                    <span>วิดีโอ / สื่อประชาสัมพันธ์</span>
                </li>
            </ol>
        </nav>
    </div>
</section>

<section class="section py-5 py-lg-7 bg-light">
    <div class="video--wrapper">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="video-player-main">
                        <div class="ratio ratio-16x9">
                            <iframe id="main-video-iframe" src="about:blank" frameborder="0"
                                    allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                    allowfullscreen></iframe>
                        </div>
                        <div class="p-4">
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb mb-3">
                                    <li class="breadcrumb-item"><a href="/video">วิดีโอ</a></li>
                                    <li id="breadcrumb-category" class="breadcrumb-item active">NPA</li>
                                </ol>
                            </nav>
                            <h2 id="video-title" class="h3 fw-bold mb-3">กำลังโหลด...</h2>
                            <p id="video-description" class="text-muted"></p>
                            <hr>
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="video-meta">
                                    <span id="video-date"></span>
                                    <span id="video-count-info" class="badge badge-video"></span>
                                </div>
                                <div class="video-share">
                                    <button class="btn btn--sam-gray mb-3" id="btn-share-main"
                                            style="min-width: 40px; width: 40px; height: 40px;">
                                        <span class="btn__icon">
                                            <svg class="icon">
                                                <use xlink:href="#icon-share"></use>
                                            </svg>
                                        </span>
                                    </button>
                                </div>
                            </div>
                            <div id="share-popover-content" style="display: none;">
                                <div class="share-options">
                                    <a href="javascript:void(0)" class="share-btn share-btn--facebook"
                                       onclick="shareTo('facebook')">
                                        <img src="~/media/images/social/icon-facebook.png" />
                                    </a>
                                    <a href="javascript:void(0)" class="share-btn share-btn--line"
                                       onclick="shareTo('line')">
                                        <img src="~/media/images/social/icon-line.png" />
                                    </a>
                                    <a href="javascript:void(0)" class="share-btn share-btn--x" onclick="shareTo('x')">
                                        <img src="~/media/images/social/icon-twitter.png" />
                                    </a>
                                    <a href="javascript:void(0)" class="share-btn share-btn--mail"
                                       onclick="shareTo('email')">
                                        <img src="~/media/images/social/icon-mail.png" />
                                    </a>
                                    <div class="share-divider"></div>
                                    <button class="share-copy-link" onclick="copyToClipboard(this)">
                                        <span class="copy-text">คัดลอกลิงก์</span>
                                        <i class="bi bi-link-45deg"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="video-player-list h-100">
                        <div class="mb-3">
                            <h5 class="h4 mb-0 fw-bold"><i class="bi bi-collection-play me-2"></i>เพลย์ลิสต์</h5>
                        </div>
                        <div class="p-0">
                            <div id="playlist-container" class="list-group list-group-flush overflow-auto"
                                 style="max-height: 600px;">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/tippy.js@6/dist/tippy.css" />
}
@section Scripts {
    <script src="https://unpkg.com/@@popperjs/core@@2"></script>
    <script src="https://unpkg.com/tippy.js@@6"></script>
    <script type="module" src="~/js/shared/share.util.js"></script>
    <script type="module">
        import { newsData } from '/js/data/data.js';

        document.addEventListener('DOMContentLoaded', () => {
        const currentId = "@ViewBag.Id";
        const videoState = {
        current: null,
        playlist: []
        };

        const init = () => {
        // 1. Fetch & Validate Data
        videoState.current = newsData.media.find(v => v.id === currentId);

        if (!videoState.current) {
        toggleError(true);
        return;
        }

        videoState.playlist = newsData.media.filter(v => v.groupId === videoState.current.groupId);

        // 2. Render UI
        renderMainPlayer();
        renderPlaylist();
        };

        const renderMainPlayer = () => {
        const { current, playlist } = videoState;
        const embedUrl = current.videoUrl.includes('youtube.com')
        ? current.videoUrl.replace("watch?v=", "embed/").split('&')[0] + "?autoplay=1&rel=0"
        : current.videoUrl;

        document.getElementById('main-video-iframe').src = embedUrl;
        document.getElementById('video-title').textContent = current.title;
        document.getElementById('video-description').textContent = current.shortDesc;
        document.getElementById('video-date').innerHTML = `<i class="bi bi-calendar3 me-1"></i> ${current.displayDate}`;
        document.getElementById('breadcrumb-category').textContent = current.category;
        document.getElementById('video-count-info').textContent = `${playlist.length} ตอนในชุดนี้`;

        // Update Page Title
        document.title = `${current.title} - @ViewData["Title"]`;
        };

        const renderPlaylist = () => {
        const container = document.getElementById('playlist-container');

        container.innerHTML = videoState.playlist.map(item => {
        const isActive = item.id === currentId;
        return `
        <a href="/video/${item.id}/${item.slug}" 
        class="list-group-item list-group-item-action border-0 p-3 ${isActive ? 'bg-soft-primary active' : ''}"
        ${isActive ? 'aria-current="true"' : ''}>
        <div class="row g-3 align-items-center">
        <div class="col-4">
        <div class="position-relative overflow-hidden rounded shadow-sm">
        <img src="${item.thumbnail}" class="img-fluid" alt="${item.title}" loading="lazy">
        ${isActive ? '<div class="playing-now"><i class="bi bi-play"></i></div>' : ''}
        </div>
        </div>
        <div class="col-8">
        <h6 class="mb-1 fw-bold text-dark text-truncate-2 small line-height-base">${item.title}</h6>
        <div class="d-flex align-items-center text-muted" style="font-size: 0.7rem;">
        <i class="bi bi-clock me-1"></i> ${item.displayDate}
        </div>
        </div>
        </div>
        </a>
        `;
        }).join('');

        // Scroll playlist to active item
        const activeItem = container.querySelector('.active');
        if (activeItem) {
        activeItem.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
        };

        const toggleError = (show) => {
        document.getElementById('main-video-player').classList.toggle('d-none', show);
        document.getElementById('video-error-state').classList.toggle('d-none', !show);
        };

        init();
        });
    </script>
}