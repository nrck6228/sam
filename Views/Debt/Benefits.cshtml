@{
    ViewData["Title"] = "หน้าหลัก | บริษัท บริหารสินทรัพย์สุขุมวิท จำกัด";
    ViewData["MetaDescription"] = "บริษัท บริหารสินทรัพย์สุขุมวิท จำกัด";
}

<section class="section section--banner">
    <div class="section__breadcrumb">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/home">หน้าแรก</a></li>
                <li class="breadcrumb-item active" aria-current="page">
                    <span>สิทธิประโยชน์ลูกหนี้</span>
                </li>
            </ol>
        </nav>
    </div>

    <div class="container-fluid">
        <h1 class="page__title">
            สิทธิประโยชน์ลูกหนี้
        </h1>
    </div>
</section>

<section>
    <div class="section section--content section--vision bg-attachment-fixed" style="background-image:url(/media/images/bg/bg-debt.jpg)">
        <div class="container-fluid">
            <div class="row">
                <div class="col-lg-6 col-md-10 mb-3 mb-lg-5">
                    <h2 class="page__title text-gradient text-gradient--green">
                        เปลี่ยนภาระ..ให้เป็นพลัง<br />ปลดล็อกชีวิตสู่อิสระทางการเงิน
                    </h2>
                    <p class="h4 font-weight-normal">
                        เพราะ SAM เข้าใจว่าวิกฤตเกิดขึ้นได้กับทุกคน เราพร้อมเคียงข้างและร่วมหาทางออกที่ดีที่สุด เพื่อให้คุณกลับมายืนได้มั่นคงอีกครั้ง
                    </p>
                    <a href="#nogo" class="btn btn--hover btn--pink mt-3">
                                <span class="btn__text">ติดต่อเจ้าหน้าที่</span>
                                <span class="btn__icon"><svg class="icon"><use xlink:href="#icon-arrow-explore"></use></svg></span>
                            </a>
                </div>
            </div>
        </div>
    </div>

    <div class="section section--content bg-light-gray py-5 py-lg-6">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12 mb-5">
                    <h3 class="page__title">
                        สิทธิพิเศษเมื่อดูแลหนี้กับ SAM
                    </h3>
                </div>

                <div class="col-12">
                    <div class="card-deck card-deck--cards-1 card-deck--cards-md-3 card-deck--cards-lg-4 grid--process">
                        <div class="grid--process-item">
                            <h5>
                                ยืดหยุ่นและเข้าใจ
                            </h5>
                            <p>
                                เงื่อนไขการผ่อนชำระที่ยืดหยุ่น พิจารณาจากความสามารถจริงของคุณ ไม่บีบบังคับ
                            </p>
                        </div>
                        <div class="grid--process-item">
                            <h5>
                                ดอกเบี้ยเป็นธรรม
                            </h5>
                            <p>
                                โอกาสได้รับยกเว้นเบี้ยปรับและดอกเบี้ยค้างชำระบางส่วน เมื่อปฏิบัติตามเงื่อนไขโครงการ
                            </p>
                        </div>
                        <div class="grid--process-item">
                            <h5>
                                ชะลอการถูกฟ้อง
                            </h5>
                            <p>
                                ช่วยชะลอการบังคับคดี หรือระงับการขายทอดตลาด (กรณีเข้าเงื่อนไข) เพื่อให้คุณยังรักษาทรัพย์สินทำกินไว้ได้
                            </p>
                        </div>
                        <div class="grid--process-item">
                            <h5>
                                โปร่งใส ตรวจสอบได้
                            </h5>
                            <p>
                                มั่นใจได้ 100% ภายใต้การกำกับดูแลที่โปร่งใส ในฐานะหน่วยงานรัฐ
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="home home--project home-wrapper">
        <div class="container-fluid">
            <div class="home__header">
                <h2 class="home__title text-gradient text-gradient--green">
                    ปิดหนี้ไว ไปต่อได้
                </h2>
            </div>
            <div class="home__body">
                <p>
                    หนี้ครัวเรือนเป็นปัญหาเชิงโครงสร้างสำคัญที่ส่งผลกระทบต่อความเป็นอยู่ที่ดีของประชาชนและการเติบโตทางเศรษฐกิจของไทย ซึ่งภาครัฐและ ธปท. ได้ร่วมกันผลักดันแนวทางแก้ไขอย่างต่อเนื่อง อย่างไรก็ตาม ภายใต้สถานการณ์ปัจจุบันที่รายได้ของครัวเรือนยังฟื้นตัวช้า ทำให้ยังมีปัญหาการชำระหนี้และกลายเป็นหนี้เสียเพิ่มขึ้น โครงการ “ปิดหนี้ไว ไปต่อได้” จึงเป็นมาตรการเฉพาะกิจ ที่จะดำเนินการเพียงครั้งเดียว มุ่งเน้นช่วยเหลือลูกหนี้รายย่อยที่เป็น NPLs ให้ได้รับการปรับโครงสร้างหนี้เพื่อลดภาระหนี้ ปิดจบหนี้ได้เร็ว และกลับมามีประวัติการชำระหนี้ที่ดีขึ้น 
                </p>
            </div>

            <div class="card-deck card-deck--cards-1 card-deck--cards-lg-2">
                    <div class="card card--stats">
                        <div class="card--stats__number">
                            100<span>%</span>
                        </div>
                        <div class="card--stats__label">
                            หยุดดอกเบี้ยถาวร
                        </div>
                    </div>

                    <div class="card card--stats">
                        <div class="card--stats__number">
                            3<span>ปี</span>
                        </div>
                        <div class="card--stats__label">
                            ระยะเวลาโครงการ
                        </div>
                    </div>
                </div>

            <div class="home__btn">
                <a href="/" title="" class="btn btn--hover btn--green">
                    <span class="btn__text">ลงทะเบียน</span>
                    <span class="btn__icon"><svg class="icon"><use xlink:href="#icon-arrow-explore"></use></svg></span>
                </a>
                <a href="/" title="" class="btn btn--hover btn--pink">
                    <span class="btn__text">ติดต่อสอบถาม</span>
                    <span class="btn__icon">
                        <svg class="icon"><use xlink:href="#icon-arrow-explore"></use></svg>
                    </span>
                </a>
                <a href="/" title="" class="btn btn--hover btn--gray">
                    <span class="btn__text">สายด่วน</span>
                    <span class="btn__icon">
                        <svg class="icon"><use xlink:href="#icon-arrow-explore"></use></svg>
                    </span>
                </a>
            </div>
        </div>
    </div>

    <div class="section section--content section--vision bg-attachment-fixed" style="background-image:url(/media/images/bg/bg-why.jpg)">
        <div class="container-fluid">
            <div class="row">
                <div class="col-lg-12 mb-3 mb-lg-5">
                    <h2 class="page__title text-gradient text-gradient--green">
                        เริ่มต้นชีวิตใหม่...ง่ายกว่าที่คิด
                    </h2>
                </div>

                <div class="col-lg-12">
                    <div class="card-deck card-deck--cards-1 card-deck--cards-md-2 card-deck--cards-lg-4">
                        <div class="card card--mission py-5">
                            <h3 class="card__title">
                                ติดต่อเรา
                            </h3>
                            <p class="card__text">โทร 1443 หรือลงทะเบียนผ่านเว็บไซต์</p>
                        </div>

                        <div class="card card--mission py-5">
                            <h3 class="card__title">
                                ประเมินความสามารถ
                            </h3>
                            <p class="card__text">เจ้าหน้าที่ช่วยวิเคราะห์รายรับ-รายจ่าย เพื่อหาจุดสมดุล</p>
                        </div>

                        <div class="card card--mission py-5">
                            <h3 class="card__title">
                                อนุมัติแผน
                            </h3>
                            <p class="card__text">ลงนามสัญญาปรับโครงสร้างหนี้ที่ตกลงร่วมกัน</p>
                        </div>

                        <div class="card card--mission py-5">
                            <h3 class="card__title">
                                ปลดล็อก!
                            </h3>
                            <p class="card__text">ชำระตรงเวลา เครดิตกลับมาดี ชีวิตไปต่อได้</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="section section--content py-5 py-lg-6">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <h3>
                        คำถามที่พบบ่อย
                    </h3>
                </div>

                <div class="col-12">
                    <div class="accordion accordion--faq" id="accordionFAQs">
                        <div class="accordion--item">
                            <div data-bs-toggle="collapse" data-bs-target="#faq-1" aria-expanded="true" aria-controls="faq-1" class="accordion__header">
                                <h4 class="accordion__title">
                                    ไม่มีเงินก้อน จะปรับโครงสร้างหนี้ได้ไหม?
                                </h4>
                                <div class="accordion__right">
                                    <span class="accordion__icon">
                                        <em class=" bi bi-chevron-down"></em>
                                    </span>
                                </div>
                            </div>
                            <div id="faq-1" class="accordion-collapse collapse show" aria-labelledby="faq-1" data-bs-parent="#accordionFAQs">
                                <div class="accordion__content ck-content">
                                    <p>
                                        หากผู้ซื้อยื่นขอสินเชื่อกับสถาบันการเงินแล้วไม่ผ่านการอนุมัติ ผู้ซื้อสามารถขอคืนเงินมัดจำได้เต็มจำนวน โดยติดต่อเจ้าหน้าที่ของ SAM พร้อมแสดงหลักฐานการยื่นขอสินเชื่อและผลการพิจารณาจากสถาบันการเงิน
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="accordion--item">
                            <div data-bs-toggle="collapse" data-bs-target="#faq-2" aria-expanded="false" aria-controls="faq-2" class="accordion__header">
                                <h4 class="accordion__title">
                                    เรื่องถึงชั้นบังคับคดีแล้ว ยังคุยกันได้ไหม?
                                </h4>
                                <span class="accordion__icon">
                                    <em class=" bi bi-chevron-down"></em>
                                </span>
                            </div>
                            <div id="faq-2" class="accordion-collapse collapse" aria-labelledby="faq-2" data-bs-parent="#accordionFAQs">
                                <div class="accordion__content ck-content">
                                    <p>
                                        ค่าโอนกรรมสิทธิ์จะถูกแบ่งออกเป็นสองส่วน คือส่วนของผู้ขายและผู้ซื้อ โดยทั่วไปแล้ว ผู้ขายจะรับผิดชอบค่าโอนในส่วนของตนเอง ส่วนผู้ซื้อจะรับผิดชอบค่าโอนในส่วนของตนเอง อย่างไรก็ตาม ในบางกรณีอาจมีการตกลงกันระหว่างผู้ซื้อและผู้ขายให้ฝ่ายใดฝ่ายหนึ่งรับผิดชอบค่าโอนทั้งหมด หรือแบ่งกันตามสัดส่วนที่ตกลงกันไว้
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="accordion--item">
                            <div data-bs-toggle="collapse" data-bs-target="#faq-3" aria-expanded="false" aria-controls="faq-3" class="accordion__header">
                                <h4 class="accordion__title">
                                    เป็นหนี้บัตรเครดิตหลายใบ ช่วยได้ไหม?
                                </h4>
                                <span class="accordion__icon">
                                    <em class=" bi bi-chevron-down"></em>
                                </span>
                            </div>
                            <div id="faq-3" class="accordion-collapse collapse" aria-labelledby="faq-3" data-bs-parent="#accordionFAQs">
                                <div class="accordion__content ck-content">
                                    <p>
                                        ค่าโอนกรรมสิทธิ์จะถูกแบ่งออกเป็นสองส่วน คือส่วนของผู้ขายและผู้ซื้อ โดยทั่วไปแล้ว ผู้ขายจะรับผิดชอบค่าโอนในส่วนของตนเอง ส่วนผู้ซื้อจะรับผิดชอบค่าโอนในส่วนของตนเอง อย่างไรก็ตาม ในบางกรณีอาจมีการตกลงกันระหว่างผู้ซื้อและผู้ขายให้ฝ่ายใดฝ่ายหนึ่งรับผิดชอบค่าโอนทั้งหมด หรือแบ่งกันตามสัดส่วนที่ตกลงกันไว้
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

