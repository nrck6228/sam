@{
    ViewData["Title"] = "หน้าหลัก | บริษัท บริหารสินทรัพย์สุขุมวิท จำกัด";
    ViewData["MetaDescription"] = "บริษัท บริหารสินทรัพย์สุขุมวิท จำกัด";
}

<section class="section section--banner">
    <div class="section__breadcrumb">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/home">หน้าแรก</a></li>
                <li class="breadcrumb-item active" aria-current="page">
                    <span>ลงทะเบียนปรับโครงสร้างหนี้</span>
                </li>
            </ol>
        </nav>
    </div>

    <div class="container-fluid">
        <h1 class="page__title">
            ลงทะเบียนปรับโครงสร้างหนี้
        </h1>
    </div>
</section>

<section>
    <div class="section section--content section--vision bg-attachment-fixed" style="background-image:url(/media/images/bg/bg-debt.jpg)">
        <div class="container-fluid">
            <div class="row">
                <div class="col-lg-6 col-md-10 mb-3 mb-lg-5">
                    <h2 class="page__title text-gradient text-gradient--green">
                        SAM ฉลองครบรอบ 25 ปี
                    </h2>
                    <p class="h4 font-weight-normal">
                        มอบสิทธิพิเศษเฉพาะลูกค้า SAM ปรับโครงสร้างหนี้ บ้าน และ ธุรกิจโครงการ “SAM ปรับหนี้มีสุข ผ่อนดีมีลด”
                    </p>
                    <a href="#nogo" class="btn btn--hover btn--pink mt-3">
                                <span class="btn__text">ปรึกษาเจ้าหน้าที่</span>
                                <span class="btn__icon"><svg class="icon"><use xlink:href="#icon-arrow-explore"></use></svg></span>
                            </a>
                </div>
            </div>
        </div>
    </div>

    <div class="section section--content mb-0">
        <div class="container-fluid p-0">
            <div class="row g-0">
                <div class="col-12">
                    <picture>
                        <source media="(min-width: 992px)" srcset="/media/images/debt/big-banner.jpg">
                        <source media="(min-width: 320px)" srcset="/media/images/debt/big-banner.jpg">
                        <img alt="" class="w-100" src="/media/images/debt/big-banner.jpg">
                    </picture>
                </div>
            </div>
        </div>
    </div>

    <div class="section section--content bg-light py-5 py-lg-6 mb-0">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="table-container">
                        <table>
                            <tbody>
                                <tr>
                                    <td class="row-header">ระยะเวลา</td>
                                    <td class="time-header col-3">เดือนที่ 0 - 6</td>
                                    <td class="time-header col-3">เดือนที่ 7 - 12</td>
                                    <td class="time-header col-3">เดือนที่ 13 เป็นต้นไป แต่ไม่เกิน 6 ปี*</td>
                                </tr>
                                <tr>
                                    <td class="row-header">อัตราดอกเบี้ย</td>
                                    <td>ไม่คิดดอกเบี้ย</td>
                                    <td>อัตราดอกเบี้ย MLR ตามที่ บสส. กำหนด</td>
                                    <td>ได้รับส่วนลดดอกเบี้ย <br>MLR -0.25%* ต่อปี <br>ตลอดอายุสัญญา</td>
                                </tr>
                                <tr>
                                    <td class="row-header">การผ่อนชำระ</td>
                                    <td>ชำระครั้งเดียว <br>หรือ ผ่อนชำระภายใน 6 เดือน</td>
                                    <td colspan="2">ค่างวดต้องไม่ต่ำกว่าดอกเบี้ยใหม่ <br>ตามอัตราดอกเบี้ย MLR</td>
                                </tr>
                                <tr>
                                    <td class="row-header">คุณสมบัติ</td>
                                    <td colspan="3">
                                        <ul>
                                            <li>1. เป็นลูกค้า SAM ทุกประเภทของเงินให้สินเชื่อที่มีหลักประกัน</li>
                                            <li>2. เป็นลูกหนี้ที่มีเจ้าหนี้รายเดียวและต้องไม่อยู่ในสถานะพิทักษ์ทรัพย์เด็ดขาด หรือ สถานะล้มละลาย หรือ ฟื้นฟูกิจการ</li>
                                            <li>3. สำหรับลูกค้า SAM ที่เคยเข้าร่วมโครงการแล้วมีการผิดนัดชำระ สามารถขอปรับโครงสร้างหนี้ใหม่ได้อีก 1 ครั้ง</li>
                                            <li>4. ระยะเวลาปรับโครงสร้างหนี้นานสูงสุด 6 ปี</li>
                                        </ul>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="section section--content bg-attachment-fixed py-5 py-lg-6 mb-0" style="background-image:url(/media/images/bg/bg-debt-form.jpg)">
        <div class="container-fluid">
            <div class="row">
                <div class="col-lg-12 mb-3 mb-lg-5">
                    <h2 class="page__title">
                        ลงทะเบียนปรับโครงสร้างหนี้
                    </h2>
                </div>
                <div class="col-lg-6">
                    <form class="form form--dark">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-4">
                                    <input type="text" class="form-control w-100" id="applyName" placeholder="ชื่อ" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-4">
                                    <input type="text" class="form-control w-100" id="applySurmane" placeholder="นามสกุล" />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-4">
                                    <input type="email" class="form-control w-100" id="applyEmail" placeholder="อีเมล" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-4">
                                    <input type="tel" class="form-control w-100" id="applyContact" placeholder="เบอร์มือถือ" />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-4">
                                    <input type="text" class="form-control w-100" id="applyId" placeholder="เลขบัตรประชาชน (13 หลัก)" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-4">
                                    <select class="form-select w-100" id="selectCreditor" aria-label="ธนาคารเจ้าหนี้">
                                        <option>ธนาคารเจ้าหนี้</option>
                                        <option>ธนาคารเจ้าหนี้</option>
                                        <option>ธนาคารเจ้าหนี้</option>
                                        <option>ธนาคารเจ้าหนี้</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-4">
                                    <input type="text" class="form-control w-100" id="applyDebtor" placeholder="รหัสลูกหนี้ (ถ้าทราบ)" />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group border-0 mb-4">
                                    <label class="h5 text-white m-0">วัตถุประสงค์การติดต่อ</label>
                                </div>

                                <div class="form-group border-0 mb-3">
                                    <div class="radio-buttons">
                                        <input type="radio" id="restructuring" name="purpose" class="radio-button" />
                                        <label for="restructuring" class="radio-button--label text-white">ต้องการเจรจาปรับโครงสร้างหนี้</label>
                                    </div>
                                </div>

                                <div class="form-group border-0 mb-3">
                                    <div class="radio-buttons">
                                        <input type="radio" id="information" name="purpose" class="radio-button" />
                                        <label for="information" class="radio-button--label text-white">ต้องการข้อมูลเพิ่มเติม</label>
                                    </div>
                                </div>

                                <div class="form-group border-0 mb-3">
                                    <div class="radio-buttons">
                                        <input type="radio" id="other" name="purpose" class="radio-button" />
                                        <label for="other" class="radio-button--label text-white">อื่นๆ</label>
                                    </div>
                                </div> 
                            </div>

                            <div class="col-md-6">
                                <div class="form-group border-0 mb-4">
                                    <label class="h5 text-white m-0">ช่วงเวลาที่สะดวกในการติดต่อ</label>
                                </div>

                                <div class="form-group border-0 mb-3">
                                    <div class="radio-buttons">
                                        <input type="radio" id="morning" name="datetime" class="radio-button" />
                                        <label for="morning" class="radio-button--label text-white">09.00 - 12.00 น.</label>
                                    </div>
                                </div>

                                <div class="form-group border-0 mb-3">
                                    <div class="radio-buttons">
                                        <input type="radio" id="afternoon" name="purpose" class="radio-button" />
                                        <label for="afternoon" class="radio-button--label text-white">13.00 - 15.00 น.</label>
                                    </div>
                                </div>

                                <div class="form-group border-0 mb-3">
                                    <div class="radio-buttons">
                                        <input type="radio" id="evening" name="purpose" class="radio-button" />
                                        <label for="evening" class="radio-button--label text-white">15.00 - 17.00 น.</label>
                                    </div>
                                </div> 
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12">
                                <div class="form-group border-0 mb-3">
                                    <label class="text-white m-0">ยินยอมให้บริษัทเก็บรวบรวม ใช้ข้อมูลส่วนบุคคล เพื่อนำเสนอผลิตภัณฑ์ บริการ สิทธิประโยชน์ รวมถึงการประชาสัมพันธ์ข้อเสนอพิเศษ ข้อมูลทางการตลาด และข้อมูลส่งเสริมการขายที่เกี่ยวข้องกับผลิตภัณฑ์บริการของบริษัท</label>
                                </div>
                                <div class="form-group border-0 mb-4">
                                    <div class="radio-buttons">
                                        <input type="radio" id="present-1" name="present" class="radio-button" />
                                        <label for="present-1" class="radio-button--label text-white">ยินยอม</label>
                                    </div>

                                    <div class="radio-buttons">
                                        <input type="radio" id="present-2" name="type" class="radio-button" />
                                        <label for="present-2" class="radio-button--label text-white">ไม่ยินยอม</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12">
                                <div class="form-group border-0 mb-3">
                                    <label class="text-white m-0">ยินยอมให้บริษัทเก็บรวบรวม ใช้ หรือเปิดเผยข้อมูลส่วนบุคคล เพื่อทำวิจัยการตลาด ทำข้อมูลสถิติ หรือข้อคิดเห็น ข้อเสนอแนะในการพัฒนาผลิตภัณฑ์ บริการ หรือระบบต่างๆ ที่จะช่วยให้สามารถนำเสนอและให้บริการในมาตรฐานที่สูงขึ้น หรือเพิ่มสิทธิและผลประโยชน์ต่างๆ</label>
                                </div>
                                <div class="form-group border-0 mb-4">
                                    <div class="radio-buttons">
                                        <input type="radio" id="research-1" name="research" class="radio-button" />
                                        <label for="research-1" class="radio-button--label text-white">ยินยอม</label>
                                    </div>

                                    <div class="radio-buttons">
                                        <input type="radio" id="research-2" name="type" class="radio-button" />
                                        <label for="research-2" class="radio-button--label text-white">ไม่ยินยอม</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12">
                                <p class="text-white">
                                    การให้ความยินยอมหรือไม่ให้ความยินยอมไม่มีผลใด ๆ ต่อการพิจารณาให้การบริการ การใช้ผลิตภัณฑ์ หรือการเข้าทำสัญญากับบริษัท โปรดอ่านและทำความเข้าใจประกาศความเป็นส่วนตัว (Privacy Notice) เพื่อรับทราบวัตถุประสงค์ที่บริษัทได้เก็บรวบรวม ใช้ หรือเปิดเผยข้อมูลส่วนบุคคล รวมถึงทราบสิทธิของเจ้าของข้อมูลส่วนบุคคล ระยะเวลาในการเก็บทำลายข้อมูล และท่านสามารถใช้สิทธิเพิกถอนความยินยอมที่ระบุไว้ข้างต้นได้ตลอดเวลา ผ่านช่องทางการใช้สิทธิของเจ้าของข้อมูลส่วนบุคคล ที่ปรากฏในประกาศความเป็นส่วนตัว
                                </p>
                            </div>

                            <div class="col-12">
                                <div class="form-group border-0 m-0">
                                    <button type="button" id="btn-reset-filter" class="btn btn--hover btn--gray">
                                        <span class="btn__text">ล้างช้อมูล</span>
                                    </button>
                                    <button type="button" id="btn-send" class="btn btn--hover btn--pink">
                                        <span class="btn__text">ส่งข้อมูล</span>
                                    </button>
                                </div>
                            </div>
                        </div> 
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Styles {
    <style>
        :root {
            --sam-green-light: #bdc9a6;
            --sam-border: #d1d1d1;
            --sam-text: #333;
        }

        .table-container {
            max-width: 1400px;
            margin: 0 auto;
            background: white;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid var(--sam-border);
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

        th, td {
            padding: 20px;
            border: 1px solid var(--sam-border);
            text-align: left;
            vertical-align: top;
        }

        /* Header Column (Green side) */
        .row-header {
            background-color: var(--sam-green-light);
            width: 20%;
            font-weight: bold;
            color: white;
            font-size: 1.1rem;
        }

        /* Time Header Row */
        .time-header {
            font-weight: bold;
            font-size: 1.2rem;
        }

        .col-3 { width: 26.6%; }
        .col-span-2 { width: 53.2%; }

        ul {
            margin: 0;
            padding-left: 20px;
        }

        li { margin-bottom: 8px; }

        /* Responsive Version */
        @@media screen and (max-width: 768px) {
            table, thead, tbody, th, td, tr {
                display: block;
            }

            .row-header {
                width: 100%;
                background-color: var(--sam-green-light);
                color: #444;
                border-bottom: none;
            }

            td {
                max-width: 100% !important;
                width: 100% !important;
                box-sizing: border-box;
                border-top: none;
            }

            tr {
                margin-bottom: 15px;
                border-bottom: 2px solid var(--sam-green-light);
            }

            /* ซ่อน cell ว่างใน mobile */
            td:empty { display: none; }
        }
    </style>
}

@section Scripts {
}