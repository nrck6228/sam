@{
    ViewData["Title"] = "หน้าหลัก | บริษัท บริหารสินทรัพย์สุขุมวิท จำกัด";
    ViewData["MetaDescription"] = "บริษัท บริหารสินทรัพย์สุขุมวิท จำกัด";
}

<section class="section section--banner">
    <div class="section__breadcrumb">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/home">หน้าแรก</a></li>
                <li class="breadcrumb-item active" aria-current="page">
                    <span>ภาพรวมการบริหารหนี้</span>
                </li>
            </ol>
        </nav>
    </div>

    <div class="container-fluid">
        <h1 class="page__title">
            ภาพรวมการบริหารหนี้
        </h1>
    </div>
</section>

<section>
    <div class="section section--content section--vision bg-attachment-fixed" style="background-image:url(/media/images/bg/bg-debt.jpg)">
        <div class="container-fluid">
            <div class="row">
                <div class="col-lg-6 col-md-10 mb-3 mb-lg-5">
                    <h2 class="page__title text-gradient text-gradient--green">
                        บริหารสินทรัพย์..<br />
                        เพื่อรากฐานเศรษฐกิจที่ยั่งยืน
                    </h2>
                    <p class="h4 font-weight-normal">
                        SAM ทำหน้าที่เป็น "กันชนทางเศรษฐกิจ" (Economic Buffer) ด้วยการบริหารจัดการสินทรัพย์ด้อยคุณภาพ (NPL) อย่างมืออาชีพ เปลี่ยนวิกฤตทางการเงินให้กลับมาเป็นพลังขับเคลื่อนประเทศอีกครั้ง
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="section section--content bg-light-gray py-5 py-lg-6 mb-0">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <h3>
                        มากกว่าการบริหารหนี้ คือการดูแลชีวิต
                    </h3>
                    <p>ในฐานะรัฐวิสาหกิจภายใต้การกำกับดูแลของธนาคารแห่งประเทศไทย (ธปท.) เรายึดมั่นในหลักธรรมาภิบาลและการช่วยเหลือสังคม เราเชื่อว่าลูกหนี้ทุกคนคือ 'พันธมิตร' ที่ต้องก้าวข้ามวิกฤตไปด้วยกัน นโยบายการบริหารหนี้ของเราจึงเน้นการ 'เจรจาเพื่อหาทางออก' (Negotiation First) มากกว่าการบังคับใช้กฎหมาย เพื่อให้ธุรกิจเดินต่อได้ และครอบครัวยังมีบ้านให้อยู่</p>
                </div>
            </div>
        </div>
    </div>

    <div class="section section--content debt--page py-5 py-lg-6">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <h2 class="page__title mb-3">
                        ผลการดำเนินงาน
                    </h2>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div style="position: relative;">
                        <div class="chart-title" style="position: absolute; right: 50px; top: 20px; color: #1d543a; font-weight: bold;">
                            ผลเรียกเก็บ NPLs <br>
                            <span style="font-size: 24px;">8,585</span> ล้านบาท
                        </div>
                        <div id="npls_chart" class="chart-box"></div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div style="position: relative;">
                        <div class="chart-title" style="position: absolute; right: 50px; top: 20px; color: #1d543a; font-weight: bold;">
                            ผลเรียกเก็บ NPLs <br>
                            <span style="font-size: 24px;">5,218</span> ล้านบาท
                        </div>
                        <div id="npas_chart" class="chart-box"></div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <div class="stats">
                        <div class="stats__grid">
                            <div class="stats__card stats__card--1">
                                <div class="stats__content">
                                    <div class="stats__text">
                                        <div class="stats__number">
                                            <span class="stats__counter" data-target="150000">0</span>+
                                        </div>
                                        <div class="stats__desc">ครอบครัวที่เราช่วยแก้หนี้</div>
                                    </div>
                                </div>
                            </div>
                            <div class="stats__card stats__card--2">
                                <div class="stats__content">

                                    <div class="stats__text">
                                        <div class="stats__number">
                                            <span class="stats__counter" data-target="20000">0</span>+
                                        </div>
                                        
                                        <div class="stats__desc">ทรัพย์สินที่กลับสู่ระบบ</div>
                                    </div>
                                </div>
                            </div>
                            <div class="stats__card stats__card--3">
                                <div class="stats__content">

                                    <div class="stats__text">
                                        <div class="stats__number">
                                            <span class="stats__counter" data-target="35000">0</span>ล้าน
                                        </div>
                                        
                                        <div class="stats__desc">มูลค่าเศรษฐกิจที่ฟื้นฟู</div>
                                    </div>
                                </div>
                            </div>
                            <div class="stats__card stats__card--4">
                                <div class="stats__content">

                                    <div class="stats__text">
                                        <div class="stats__number">
                                            <span class="stats__counter" data-target="98">0</span>%
                                        </div>
                                        <div class="stats__desc">ความพึงพอใจ</div>
                                    </div>
                                </div>
                            </div>
                            <div class="stats__card stats__card--5">
                                <div class="stats__content">

                                    <div class="stats__text">
                                        <div class="stats__number">
                                            <span class="stats__counter" data-target="25">0</span>ปี
                                        </div>
                                        
                                        <div class="stats__desc">เคียงข้างคนไทย</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Styles {
    <style>
        .chart-box { width: 100%; height: 450px; }
        .chart-title { position: absolute; right: 50px; top: 20px; color: #1d543a; font-weight: bold; z-index: 1; display: none;}
    </style>
}

@section Scripts {
    <script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
    <script type="module" src="~/js/features/debt/debt.js"></script>
    <script type="text/javascript">
        google.charts.load('current', {'packages':['corechart']});
        google.charts.setOnLoadCallback(drawCharts);

        function drawCharts() {
            // ข้อมูลสำหรับ NPLs
            var dataNPL = google.visualization.arrayToDataTable([
                ['Category', 'Amount'],
                ['ประนอมหนี้', 70], // ค่าสมมติเพื่อให้รูปทรงใกล้เคียง
                ['ขายทอดตลาด', 30]
            ]);

            // ข้อมูลสำหรับ NPAs
            var dataNPA = google.visualization.arrayToDataTable([
                ['Category', 'Amount'],
                ['ที่อยู่อาศัย', 45],
                ['อาคารเพื่อการพาณิชย์', 20],
                ['ที่ดินเปล่า', 34],
                ['อื่นๆ', 1]
            ]);

            // การตั้งค่าสไตล์ (เน้นสีตามรูปภาพ)
            var commonOptions = {
                pieHole: 0.5, // ทำให้เป็นโดนัท
                chartArea: { top: 60, width: '90%', height: '80%' },
                legend: { 
                    position: 'right', 
                    alignment: 'center',
                    textStyle: { fontName: 'Noto Sans Thai', fontSize: 14 } 
                },
                pieSliceText: 'none',
                tooltip: { trigger: 'selection' }
            };

            // Option เฉพาะของ NPL
            var optionsNPL = Object.assign({}, commonOptions, {
                title: 'ผลเรียกเก็บ NPLs \n8,585 ล้านบาท',
                titleTextStyle: { fontName: 'Noto Sans Thai', color: '#1d543a', fontSize: 18, bold: true },
                colors: ['#285e3e', '#e3a1ac'] // เขียวเข้ม, ชมพู
            });

            // Option เฉพาะของ NPA
            var optionsNPA = Object.assign({}, commonOptions, {
                title: 'ผลเรียกเก็บ NPAs \n5,218 ล้านบาท',
                titleTextStyle: { fontName: 'Noto Sans Thai', color: '#1d543a', fontSize: 18, bold: true },
                colors: ['#285e3e', '#e3a1ac', '#f4d96b', '#cbd5e0'] // เขียว, ชมพู, เหลือง, เทา
            });

            // วาดกราฟ
            var chartNPL = new google.visualization.PieChart(document.getElementById('npls_chart'));
            chartNPL.draw(dataNPL, optionsNPL);

            var chartNPA = new google.visualization.PieChart(document.getElementById('npas_chart'));
            chartNPA.draw(dataNPA, optionsNPA);
        }
    </script>
}