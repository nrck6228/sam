@{
    ViewData["Title"] = "หน้าหลัก | บริษัท บริหารสินทรัพย์สุขุมวิท จำกัด";
    ViewData["MetaDescription"] = "บริษัท บริหารสินทรัพย์สุขุมวิท จำกัด";
}

<section class="section section--banner">
    <div class="section__breadcrumb">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/home">หน้าแรก</a></li>
                <li class="breadcrumb-item active" aria-current="page">
                    <span>ขั้นตอนการปรับโครงสร้างหนี้</span>
                </li>
            </ol>
        </nav>
    </div>

    <div class="container-fluid">
        <h1 class="page__title">
            ขั้นตอนการปรับโครงสร้างหนี้
        </h1>
    </div>
</section>

<section>
    <div class="section section--content section--vision bg-attachment-fixed"
         style="background-image:url(/media/images/bg/bg-debt.jpg)">
        <div class="container-fluid">
            <div class="row">
                <div class="col-lg-6 col-md-10 mb-3 mb-lg-5">
                    <h2 class="page__title text-gradient text-gradient--green">
                        เริ่มต้นชีวิตทางการเงินใหม่.. <br />แค่เปิดใจคุยกับเรา
                    </h2>
                    <p class="h4 font-weight-normal">
                        ไม่ว่าสถานะหนี้ของคุณจะเป็นอย่างไร SAM
                        พร้อมรับฟังและร่วมหาทางออกที่เหมาะสมกับความสามารถในการชำระจริงของคุณ
                        เพื่อให้คุณและครอบครัวก้าวต่อไปได้
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="section section--content bg-light-gray py-5 py-lg-6">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12 mb-5">
                    <h3 class="page__title">
                        4 ขั้นตอนสู่การปลดหนี้
                    </h3>
                </div>

                <div class="col-12">
                    <div class="card-deck card-deck--cards-1 card-deck--cards-md-3 card-deck--cards-lg-4 grid--process">
                        <div class="grid--process-item">
                            <h5>
                                เตรียมเอกสารและติดต่อเรา
                            </h5>
                            <p>
                                เตรียมเอกสารแสดงรายได้และภาระหนี้ ติดต่อเจ้าหน้าที่ผ่านช่องทางออนไลน์ หรือสาขาใกล้บ้าน
                                เพื่อยืนยันตัวตน
                            </p>
                        </div>
                        <div class="grid--process-item">
                            <h5>
                                ปรึกษาและหาแนวทางร่วมกัน
                            </h5>
                            <p>
                                พูดคุยเปิดอกกับเจ้าหน้าที่ เพื่อประเมินรายรับ-รายจ่าย และเลือกแผนการผ่อนชำระที่ 'คุณไหว'
                                จริงๆ
                            </p>
                        </div>
                        <div class="grid--process-item">
                            <h5>
                                พิจารณาและอนุมัติ
                            </h5>
                            <p>
                                SAM พิจารณาคำร้องขอปรับปรุงโครงสร้างหนี้ และแจ้งผลการอนุมัติให้คุณทราบอย่างรวดเร็ว
                                โปร่งใส
                            </p>
                        </div>
                        <div class="grid--process-item">
                            <h5>
                                ทำสัญญาและเริ่มต้นใหม่
                            </h5>
                            <p>
                                ลงนามในสัญญาปรับโครงสร้างหนี้ และเริ่มผ่อนชำระตามเงื่อนไขใหม่...
                                เพื่อเครดิตที่ดีและชีวิตที่อิสระ
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="section section--content py-5 py-lg-6">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12 mb-3">
                    <h3 class="page__title">
                        เอกสารที่ต้องเตรียม
                    </h3>
                </div>

                <div class="col-12 col-md-6">
                    <hr />
                    <div class="ck-content">
                        <h5>
                            ผู้มีรายได้ประจำ
                        </h5>
                        <ul class="list-unstyled">
                            <li>1. สำเนาบัตรประชาชน (พร้อมรับรองสำเนาถูกต้อง)</li>
                            <li>2. สำเนาทะเบียนบ้าน</li>
                            <li>3. สำเนาทะเบียนสมรส / ใบเปลี่ยนชื่อ-สกุล (ถ้ามี)</li>
                            <li>4. สลิปโอนเงินประกันซอง</li>
                        </ul>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <hr />
                    <div class="ck-content">
                        <h5>
                            อาชีพอิสระ / ธุรกิจส่วนตัว
                        </h5>
                        <ul class="list-unstyled">
                            <li>1. สำเนาหนังสือรับรองบริษัท (ไม่เกิน 3 เดือน)</li>
                            <li>2. สำเนาบัตรประชาชนกรรมการผู้มีอำนาจ</li>
                            <li>3. สำเนาภพ.20 (ถ้ามี)</li>
                            <li>4. รายงานการประชุมคณะกรรมการที่มีมติให้ซื้อทรัพย์</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="section section--content bg-light-gray py-5 py-lg-6 mb-0">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12 mb-5">
                    <h3 class="page__title">
                        ช่องทางติดต่อ
                    </h3>
                </div>

                <div class="col-12">
                    <div class="card-deck card-deck--cards-1 card-deck--cards-md-3 grid--process">
                        <div class="grid--process-item">
                            <div class="grid--process-item__icon">
                                <i class="bi bi-globe"></i>
                            </div>
                            <h5>
                                ยื่นออนไลน์
                            </h5>
                            <p>
                                สมัครผ่านเว็บไซต์ หรือแอปฯ ทางรัฐ สะดวก รวดเร็ว ไม่ต้องเดินทาง
                            </p>
                            <a href="/debt/register" class="btn btn--hover btn--green mt-auto">
                                <span class="btn__text">ลงทะเบียน</span>
                                <span class="btn__icon"><svg class="icon">
                                    <use xlink:href="#icon-arrow-explore"></use>
                                </svg></span>
                            </a>
                        </div>
                        <div class="grid--process-item">
                            <div class="grid--process-item__icon">
                                <i class="bi bi-envelope"></i>
                            </div>
                            <h5>
                                ไปรษณีย์
                            </h5>
                            <p>
                                ดาวน์โหลดแบบฟอร์ม กรอกข้อมูล และส่งเอกสารมาที่สำนักงานใหญ่
                            </p>
                            <a href="/debt/download" class="btn btn--hover btn--green mt-auto">
                                <span class="btn__text">ดาวน์โหลดแบบฟอร์ม</span>
                                <span class="btn__icon"><svg class="icon">
                                    <use xlink:href="#icon-arrow-explore"></use>
                                </svg></span>
                            </a>
                        </div>
                        <div class="grid--process-item">
                            <div class="grid--process-item__icon">
                                <i class="bi bi-building"></i>
                            </div>
                            <h5>
                                ติดต่อสาขา
                            </h5>
                            <p>
                                พบเจ้าหน้าที่ที่สำนักงาน SAM หรือสาขาทั่วประเทศ (กรุณานัดหมายล่วงหน้า)
                            </p>
                            <a href="/contact-us" class="btn btn--hover btn--green mt-auto">
                                <span class="btn__text">ค้นหาสาขา</span>
                                <span class="btn__icon"><svg class="icon">
                                    <use xlink:href="#icon-arrow-explore"></use>
                                </svg></span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="section section--content section--vision bg-attachment-fixed"
         style="background-image:url(/media/images/bg/bg-why.jpg)">
        <div class="container-fluid">
            <div class="row">
                <div class="col-lg-12 mb-3 mb-lg-5">
                    <h2 class="page__title text-gradient text-gradient--green">
                        ข้อดีของการปรับโครงสร้างหนี้
                    </h2>
                </div>

                <div class="col-lg-12">
                    <div class="card-deck card-deck--cards-1 card-deck--cards-md-2 card-deck--cards-lg-4">
                        <div class="card card--mission py-5">
                            <h3 class="card__title">
                                ระงับการฟ้องร้อง
                            </h3>
                            <p class="card__text">ชะลอการบังคับคดี หรือยึดทรัพย์ (ตามเงื่อนไข)</p>
                        </div>

                        <div class="card card--mission py-5">
                            <h3 class="card__title">
                                ลดภาระดอกเบี้ย
                            </h3>
                            <p class="card__text">ตัดวงจรดอกเบี้ยทบต้น ผ่อนเฉพาะยอดที่ตกลงกัน</p>
                        </div>

                        <div class="card card--mission py-5">
                            <h3 class="card__title">
                                ยืดระยะเวลา
                            </h3>
                            <p class="card__text">ขยายเวลาผ่อนชำระให้นานขึ้น เพื่อให้ค่างวดลดลง</p>
                        </div>

                        <div class="card card--mission py-5">
                            <h3 class="card__title">
                                กู้เครดิตคืน
                            </h3>
                            <p class="card__text">เมื่อผ่อนชำระปกติ ประวัติในเครดิตบูโรจะดีขึ้นในอนาคต</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Styles {
}

@section Scripts {
}