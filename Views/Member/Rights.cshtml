@{
    ViewData["Title"] = "หน้าหลัก | บริษัท บริหารสินทรัพย์สุขุมวิท จำกัด";
    ViewData["MetaDescription"] = "บริษัท บริหารสินทรัพย์สุขุมวิท จำกัด";
}

<section class="section section--banner">
    <div class="section__breadcrumb">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/home">หน้าแรก</a></li>
                <li class="breadcrumb-item active" aria-current="page">
                    <span>สิทธิ์ของสมาชิก</span>
                </li>
            </ol>
        </nav>
    </div>

    <div class="container-fluid">
        <h1 class="page__title">
            สิทธิ์ของสมาชิก
        </h1>
    </div>
</section>

<section>
    <div class="section section--content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="accordion accordion--faq" id="accordionFaqs">
                        <div class="accordion--item">
                            <div data-bs-toggle="collapse" data-bs-target="#faq-1" aria-expanded="true"
                                 aria-controls="faq-1" class="accordion__header">
                                <h4 class="accordion__title">
                                    1. สิทธิ์พื้นฐาน
                                </h4>
                                <div class="accordion__right">
                                    <span class="accordion__icon">
                                        <em class=" bi bi-chevron-down"></em>
                                    </span>
                                </div>
                            </div>
                            <div id="faq-1" class="accordion-collapse collapse show" aria-labelledby="faq-1"
                                 data-bs-parent="#accordionFaqs">
                                <div class="accordion__content ck-content">
                                    <p>
                                        SAM คือ บริษัท บริหารสินทรัพย์สุขุมวิท จำกัด (บสส. / SAM)
                                        เป็นหน่วยงานภาครัฐที่อยู่ภายใต้การกำกับดูแลของธนาคารแห่งประเทศไทย
                                        ดำเนินธุรกิจในด้านการบริหารสินทรัพย์ด้อยคุณภาพของระบบสถาบันการเงิน
                                        โดยทำหน้าที่แก้ไขหนี้ด้อยคุณภาพ
                                        เจรจาหาข้อยุติกับลูกค้าด้วยการปรับปรุงโครงสร้างหนี้ NPL
                                        พัฒนาการจำหน่ายทรัพย์สินรอการขาย NPA เพื่อช่วยฟื้นฟูระบบเศรษฐกิจของประเทศ
                                        และสนับสนุนให้ประชาชนและภาคธุรกิจฟื้นตัวได้อย่างยั่งยืน
                                    </p>
                                    <ul>
                                        <li>
                                            การแก้ไขข้อมูลส่วนตัว :
                                            ช่องทางในการอัปเดตข้อมูลส่วนตัว เช่น ที่อยู่, เบอร์โทรศัพท์, หรืออีเมล
                                            เพื่อให้ข้อมูลมีความถูกต้องเสมอ
                                        </li>
                                        <li>
                                            การจัดการความปลอดภัย :
                                            สิทธิ์ในการเปลี่ยนรหัสผ่าน (Password) เพื่อความปลอดภัยที่เพิ่มขึ้น
                                        </li>
                                        <li>
                                            การจัดการการแจ้งเตือน :
                                            เลือกประเภทและช่องทางของการแจ้งเตือนที่ต้องการรับ เช่น ทางอีเมล, SMS,
                                            หรือการแจ้งเตือนภายในแอปพลิเคชัน
                                        </li>
                                        <li>
                                            การจัดการการเข้าสู่ระบบ :
                                            แสดงประวัติการเข้าสู่ระบบและอุปกรณ์ที่กำลังเข้าใช้งานอยู่
                                            พร้อมสิทธิ์ในการสั่งออกจากระบบในอุปกรณ์อื่นๆ เพื่อความปลอดภัย
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <div class="accordion--item">
                            <div data-bs-toggle="collapse" data-bs-target="#faq-2" aria-expanded="false"
                                 aria-controls="faq-2" class="accordion__header">
                                <h4 class="accordion__title">
                                    2. การจัดการบัญชี
                                </h4>
                                <span class="accordion__icon">
                                    <em class=" bi bi-chevron-down"></em>
                                </span>
                            </div>
                            <div id="faq-2" class="accordion-collapse collapse" aria-labelledby="faq-2"
                                 data-bs-parent="#accordionFaqs">
                                <div class="accordion__content ck-content">
                                    <ul>
                                        <li>
                                            การแก้ไขข้อมูลส่วนตัว :
                                            ช่องทางในการอัปเดตข้อมูลส่วนตัว เช่น ที่อยู่, เบอร์โทรศัพท์, หรืออีเมล
                                            เพื่อให้ข้อมูลมีความถูกต้องเสมอ
                                        </li>
                                        <li>
                                            การจัดการความปลอดภัย :
                                            สิทธิ์ในการเปลี่ยนรหัสผ่าน (Password) เพื่อความปลอดภัยที่เพิ่มขึ้น
                                        </li>
                                        <li>
                                            การจัดการการแจ้งเตือน :
                                            เลือกประเภทและช่องทางของการแจ้งเตือนที่ต้องการรับ เช่น ทางอีเมล, SMS,
                                            หรือการแจ้งเตือนภายในแอปพลิเคชัน
                                        </li>
                                        <li>
                                            การจัดการการเข้าสู่ระบบ :
                                            แสดงประวัติการเข้าสู่ระบบและอุปกรณ์ที่กำลังเข้าใช้งานอยู่
                                            พร้อมสิทธิ์ในการสั่งออกจากระบบในอุปกรณ์อื่นๆ เพื่อความปลอดภัย
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <div class="accordion--item">
                            <div data-bs-toggle="collapse" data-bs-target="#faq-3" aria-expanded="false"
                                 aria-controls="faq-3" class="accordion__header">
                                <h4 class="accordion__title">
                                    3. สิทธิ์การเข้าถึงบริการและทรัพย์สิน
                                </h4>
                                <span class="accordion__icon">
                                    <em class=" bi bi-chevron-down"></em>
                                </span>
                            </div>
                            <div id="faq-3" class="accordion-collapse collapse" aria-labelledby="faq-3"
                                 data-bs-parent="#accordionFaqs">
                                <div class="accordion__content ck-content">
                                    <p>
                                        SAM ไม่มีนโยบายในด้านการปล่อยสินเชื่อ / เงินกู้ และไม่มีการเรียกรับผลประโยชน์ใดๆ
                                        จากลูกค้า โปรดระมัดระวังมิจฉาชีพที่แอบแฝงใช้ชื่อ บริษัท บริหารสินทรัพย์สุขุมวิท
                                        จำกัด หรือ SAM หรือ บสส. หลอกลวง แอบอ้าง ผ่านช่องทางการสื่อสารต่างๆ
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

