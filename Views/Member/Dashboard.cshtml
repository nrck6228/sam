@section Styles {
    <style>
        .chart--div {
            width: 100%;
            height: 350px;
        }

        /* Custom Legend Styles */
        #custom_legend {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 0;
            padding-left: 20px;
            position: absolute;
            top: 50%;
            right: 1rem;
            transform: translateY(-50%);
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 1rem;
            color: #363636;
        }

        .circle {
            width: 15px;
            height: 15px;
            border-radius: 50%;
            /* ทำให้เป็นวงกลม */
            display: inline-block;
        }

        /* Dropdown Style */
        .year-select {
            padding: 8px 35px 8px 15px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-family: 'Noto Sans Thai';
            font-size: 16px;
            color: #666;
            appearance: none;
            background: url('data:image/svg+xml;charset=US-ASCII,<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20"><path fill="%23999" d="M5 7l5 5 5-5z"/></svg>') no-repeat right 10px center;
            background-color: white;
            cursor: pointer;
            min-width: 120px;
        }

        .unit-label {
            font-size: 12px;
            color: #999;
            margin-bottom: 5px;
        }
    </style>
}

@section Scripts {
    <script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
    <script type="text/javascript">
        google.charts.load('current', { 'packages': ['corechart'] });
        google.charts.setOnLoadCallback(drawCharts);

        // ข้อมูลยอดขายรายเดือน (จำลอง)
        const yearlyData = {
        '2025': [
        ['JAN', 500], ['FEB', 120], ['MAR', 620], ['APR', 450], ['MAY', 730], ['JUN', 400],
        ['JUL', 140], ['AUG', 220], ['SEP', 600], ['OCT', 260], ['NOV', 300], ['DEC', 580]
        ],
        '2024': [
        ['JAN', 300], ['FEB', 400], ['MAR', 200], ['APR', 550], ['MAY', 430], ['JUN', 600],
        ['JUL', 540], ['AUG', 320], ['SEP', 400], ['OCT', 560], ['NOV', 700], ['DEC', 480]
        ]
        };

        function drawCharts() {
        drawBarChart();
        drawDonutChart();
        updateLineChart();
        }

        // ฟังก์ชันวาดกราฟแท่ง
        function drawBarChart() {
        var data = google.visualization.arrayToDataTable([
        ['ประเภท', 'ยอดขาย', { role: 'style' }, { role: 'annotation' }],
        ['บ้าน', 320, '#2e5a39', '320 ล้านบาท'],
        ['คอนโด', 560, '#df9faa', '560 ล้านบาท'],
        ['ที่ดิน', 240, '#f2d65f', '240 ล้านบาท'],
        ['อื่นๆ', 480, '#ced4da', '480 ล้านบาท']
        ]);

        var options = {
        fontSize: 16,
        fontName: 'Noto Sans Thai',
        chartArea: { width: '70%', height: '70%' },
        hAxis: {
        title: '',
        minValue: 0,
        gridlines: { color: 'transparent' }, // ซ่อนเส้นตารางแนวตั้ง
        textPosition: 'none' // ซ่อนตัวเลขแกน X
        },
        vAxis: {
        title: '',
        textStyle: { fontSize: 0 } // ซ่อนชื่อแกน Y เพื่อเลียนแบบตามภาพ
        },
        legend: { position: 'none' },
        bar: { groupWidth: '75%' }, // ความหนาของแท่ง
        annotations: {
        alwaysOutside: false,
        textStyle: {
        fontSize: 16,
        color: '#fff', // ตัวเลขสีขาวในแท่ง
        bold: false
        }
        },
        backgroundColor: 'transparent'
        };

        var chart = new google.visualization.BarChart(document.getElementById('bar_chart_div'));
        chart.draw(data, options);
        }

        // ฟังก์ชันวาดกราฟโดนัท
        function drawDonutChart() {
        var data = google.visualization.arrayToDataTable([
        ['สถานะ', 'จำนวน'],
        ['ว่าง', 45],
        ['จองแล้ว', 20],
        ['ขายแล้ว', 30],
        ['อื่นๆ', 5]
        ]);

        var options = {
        pieHole: 0.6, // กำหนดขนาดรูตรงกลางเพื่อให้เป็นโดนัท
        fontSize: 16,
        fontName: 'Noto Sans Thai',
        chartArea: { width: '70%', height: '70%', left: 20 },
        colors: ['#2e5a39', '#df9faa', '#f2d65f', '#ced4da'], // สีตามภาพ
        legend: { position: 'none' },
        pieSliceText: 'none', // ซ่อนตัวเลขบนแผ่นกราฟเพื่อให้คลีนเหมือนในรูป
        backgroundColor: 'transparent'
        };

        var chart = new google.visualization.PieChart(document.getElementById('donut_chart_div'));
        chart.draw(data, options);
        }

        // ฟังก์ชันอัปเดตกราฟเส้นตามปีที่เลือก
        function updateLineChart() {
        const year = document.getElementById('yearPicker').value;
        const rawData = yearlyData[year];
            
        var data = new google.visualization.DataTable();
        data.addColumn('string', 'Month');
        data.addColumn('number', 'ยอดขาย');
        data.addRows(rawData);

        var options = {
        curveType: 'function', // ทำให้เส้นโค้ง
        fontSize: 16,
        fontName: 'Noto Sans Thai',
        legend: { position: 'bottom', alignment: 'center', textStyle: { color: '#999', fontSize: 14 } },
        colors: ['#df9faa'], // สีชมพูตามภาพ
        lineWidth: 3,
        pointSize: 7, // จุดวงกลมบนเส้น
        dataOpacity: 0.8,
        chartArea: { left: 50, right: 20, top: 20, bottom: 80, width: '90%', height: '70%' },
        hAxis: {
        textStyle: { color: '#666', fontSize: 12 },
        gridlines: { color: 'transparent' }
        },
        vAxis: {
        textStyle: { color: '#666', fontSize: 12 },
        gridlines: { color: '#f3f3f3' }, // เส้นตารางแนวนอนบางๆ
        viewWindow: { min: 0, max: 1000 }
        },
        backgroundColor: 'transparent',
        animation: { startup: true, duration: 1000, easing: 'out' } // เพิ่ม Animation ตอนเปลี่ยนปี
        };

        var chart = new google.visualization.LineChart(document.getElementById('line_chart_div'));
        chart.draw(data, options);
        }

        // 2. ฟีเจอร์ Resize: ดักจับการเปลี่ยนขนาดหน้าจอ
        let resizeTimer;
        window.addEventListener('resize', function () {
        // ใช้ Debounce เพื่อไม่ให้วาดใหม่ถี่ยิบขณะลากหน้าจอ
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(function () {
        console.log("Resizing and redrawing charts...");
        drawCharts();
        }, 200); // รอ 200ms หลังจากหยุดลากแล้วค่อยวาดใหม่
        });
    </script>
}