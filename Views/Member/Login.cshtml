@{
    ViewData["Title"] = "หน้าหลัก | บริษัท บริหารสินทรัพย์สุขุมวิท จำกัด";
    ViewData["MetaDescription"] = "บริษัท บริหารสินทรัพย์สุขุมวิท จำกัด";
}

<section class="section section--banner">
    <div class="section__breadcrumb">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/home">หน้าแรก</a></li>
                <li class="breadcrumb-item active" aria-current="page">
                    <span>เข้าสู่ระบบสมาชิก</span>
                </li>
            </ol>
        </nav>
    </div>

    <div class="container-fluid">
        <h1 class="page__title">
            เข้าสู่ระบบสมาชิก
        </h1>
    </div>
</section>

<section class="section section--content section--vision bg-attachment-fixed"
         style="background-image:url(/media/images/bg/bg-debt.jpg); min-height: 80vh; display: flex; align-items: center;">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-lg-4 col-md-6 col-10">
                <form class="form form--dark" style="background-color: rgba(0,0,0,0.64);">
                        <div class="mb-4 text-start">
                            <label class="h6 font-weight-normal text-white-50 m-0">ยินดีต้อนรับ</label><br />
                            <h2 class="h2 text-white m-0">เข้าสู่ระบบสมาชิก</h2>
                        </div>

                        <div class="form-group mb-4">
                            <input type="text" class="form-control w-100" id="applyUsername"
                                placeholder=" " />
                                <label class="form-label">อีเมล / ชื่อผู้ใช้</label>
                        </div>

                        <div class="form-group mb-3" style="position: relative;">
                            <input type="password" class="form-control w-100" id="applyPassword"
                                placeholder=" " style="padding-right: 45px;" />
                                <label class="form-label">รหัสผ่าน</label>
                            <i class="bi bi-eye" id="togglePassword" role="button" aria-label="แสดงรหัสผ่าน"
                                style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); cursor: pointer; color: #ccc; font-size: 1.2rem;">
                            </i>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check m-0">
                                <input class="form-check-input" type="checkbox" id="rememberMe">
                                <label class="form-check-label text-white small" role="button" for="rememberMe">
                                    จำรหัสผ่าน
                                </label>
                            </div>
                            <a href="#" class="text-white-50 small text-decoration-none">ลืมรหัสผ่าน?</a>
                        </div>

                        <div class="d-flex align-items-center gap-3 mb-5">
                            <button type="button" id="btn-send" class="btn btn--sam-pink px-4">
                                <span class="btn__text">เข้าสู่ระบบ</span>
                            </button>
                            <span class="text-white-50 small">ยังไม่เป็นสมาชิก? <a href="#" class="text-white text-decoration-none border-bottom">สมัครสมาชิก</a></span>
                        </div>

                        <div class="position-relative text-center mb-4">
                            <hr class="text-white-50">
                            <span class="position-absolute top-50 start-0 translate-middle-y px-3 text-white-50 small"
                                  style="background-color: #444;">หรือ</span>
                        </div>

                        <div class="text-center">
                            <label class="text-white-50 small d-block mb-3">ลงชื่อเข้าใช้ด้วย</label>
                            <div class="d-flex justify-content-center gap-4 social-icons">
                                <a href="#" class="text-white h3"><i class="bi bi-google"></i></a>
                                <a href="#" class="text-white h3"><i class="bi bi-facebook"></i></a>
                                <a href="#" class="text-white h3"><i class="bi bi-apple"></i></a>
                            </div>
                        </div>
                </form>
            </div>
        </div>
    </section>

    @section Styles {
    <style>
        /* Social Icons Hover */
        .social-icons a { transition: 0.2s; opacity: 0.8; }
        .social-icons a:hover { opacity: 1; transform: translateY(-3px); }

        /* ปรับแต่ง Checkbox */
        .form-check-input:checked {
            background-color: #444 !important;
            border-color: white !important;
        }
    </style>
}

    @section Scripts {
        <script>
            const passwordInput = document.querySelector('#applyPassword');
            const toggleIcon = document.querySelector('#togglePassword');

            toggleIcon.addEventListener('click', function () {
                // 1. ตรวจสอบสถานะปัจจุบัน
                const isPassword = passwordInput.getAttribute('type') === 'password';

                // 2. สลับ Type ของ Input
                passwordInput.setAttribute('type', isPassword ? 'text' : 'password');

                // 3. สลับ Class ของไอคอน
                this.classList.toggle('bi-eye');
                this.classList.toggle('bi-eye-slash');

                // 4. อัปเดต aria-label ให้สอดคล้องกับสถานะใหม่ (Action-Oriented)
                // ถ้าตอนนี้เป็น text (แสดงอยู่) -> บอกผู้ใช้ว่ากดเพื่อ "ซ่อน"
                // ถ้าตอนนี้เป็น password (ซ่อนอยู่) -> บอกผู้ใช้ว่ากดเพื่อ "แสดง"
                const newLabel = isPassword ? 'ซ่อนรหัสผ่าน' : 'แสดงรหัสผ่าน';
                this.setAttribute('aria-label', newLabel);
            });
        </script>
    }