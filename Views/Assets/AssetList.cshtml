@{
    ViewData["Title"] = "รายการทรัพย์สิน | SAM";
}

<section class="section section--banner section--banner-search">
    <div class="section__breadcrumb">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <span>ทรัพย์สินรอการขาย</span>
                </li>
                <li class="breadcrumb-item"><a href="/npa/asset-category">ประเภททรัพย์</a></li>
                <li class="breadcrumb-item active">
                    <span id="breadcrumb-current-text">กำลังโหลด...</span>
                </li>
            </ol>
        </nav>
    </div>

    <div class="page--banner">
        <img src="~/media/images/bg/bg-assets-list.jpg" alt="Asset List Banner" class="banner__image">
    </div>

    <div class="page--search">
        <div class="container">
            <partial name="_SearchPanel" />
        </div>
    </div>

    <div class="page--nav">
        <a href="#" title="" class="btn btn--green btn--hover">
            <span class="btn__text">จับคู่ทรัพย์สิน NPA</span>
            <span class="btn__icon"><svg class="icon">
                <use xlink:href="#icon-arrow-explore"></use>
            </svg></span>
        </a>
        <a href="#" title="" class="btn btn--pink btn--hover">
            <span class="btn__text">ทรัพย์ขายทอดตลาดกรมบังคับคดี</span>
            <span class="btn__icon"><svg class="icon">
                <use xlink:href="#icon-arrow-explore"></use>
            </svg></span>
        </a>
    </div>
</section>

<section class="section section--assets">
    <h1 class="page__title d-none" id="list-title">รายการทรัพย์สิน</h1>

    <div class="container-fluid">
        <div class="row mb-3">
            <div class="col-auto">
                <button id="btn-print-list" class="btn btn--hover btn--gray">
                    <span class="btn__icon">
                        <i class="bi bi-printer"></i>
                    </span>
                    <span class="btn__text">พิมพ์รายการทรัพย์</span>
                </button>
            </div>
        </div>

        <div class="row justify-content-between align-items-center mb-3">
            <div class="col-lg-auto">
                <h4 class="page__subtitle m-0">ผลการค้นหา <span id="asset-count">0</span> รายการ
                </h4>
            </div>

            <div class="col-lg-auto">
                <div class="d-flex align-items-center gap-3">
                    <div class="form form--sorted m-0">
                        <div class="form-group">
                            <label for="sort-criteria">เรียงตาม</label>
                            <div class="select">
                                <select id="sort-criteria" class="select__input">
                                    <option value="newest">ใหม่ล่าสุด</option>
                                    <option value="code-asc">รหัสทรัพย์: (A-Z)</option>
                                    <option value="code-desc">รหัสทรัพย์: (Z-A)</option>
                                    <option value="price-asc">ราคาต่ำ-สูง</option>
                                    <option value="price-desc">ราคาสูง-ต่ำ</option>
                                    <option value="size-asc">พื้นที่: น้อย-มาก</option>
                                    <option value="size-desc">พื้นที่: มาก-น้อย</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form form--sorted m-0">
                        <div class="form-group">
                            <label for="items-per-page">แสดงผลต่อหน้า</label>
                            <div class="search">
                                <input type="text" id="items-per-page" inputmode="numeric" pattern="[0-9]*" value="20"
                                       autocomplete="off" class="search__input">
                            </div>
                            <label for="items-per-page">รายการ</label>
                        </div>
                    </div>

                    <button type="button" id="items-per-page-apply" class="btn btn--sam-green">
                        <span class="btn__text">ตกลง</span>
                    </button>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div id="asset-result-list"
                     class="card-deck card-deck--cards-1 card-deck--cards-md-2 card-deck--cards-lg-4">
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center pagination--primary" id="asset-pagination">
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</section>

<div id="compare-sticky-bar" class="compare--bar">
    <div class="container-fluid">
        @* แท็บสลับระหว่าง 2 รายการ: เปรียบเทียบ / โบรชัวร์ *@
        <div class="compare--tabs">
            <button type="button" class="compare--tab active" data-tab="compare">
                เปรียบเทียบ (<span id="compare-count">0</span>)
            </button>
            <button type="button" class="compare--tab" data-tab="brochure">
                โบรชัวร์ (<span id="brochure-count">0</span>)
            </button>
        </div>

        @* แผงรายการ "เปรียบเทียบ" (สูงสุด 5 รายการ) *@
        <div class="compare--panel" data-panel="compare">
            <div class="row align-items-center">
                <div class="col-lg-9">
                    <div id="compare-preview-items" class="compare--grid compare--grid--scroll"></div>
                </div>
                <div class="col-lg-3 text-end mt-3 mt-lg-0">
                    <button class="btn btn--hover btn--green" onclick="window.goToComparePage()">
                        <span class="btn__text">เปรียบเทียบ</span>
                    </button>
                    <button class="btn btn--hover btn--gray" onclick="clearAllCompare()">
                        <span class="btn__text">ล้างตัวเลือก</span>
                    </button>
                </div>
            </div>
        </div>

        @* แผงรายการ "โบรชัวร์" (ไม่จำกัดจำนวน — เลื่อนแนวนอนได้) *@
        <div class="compare--panel d-none" data-panel="brochure">
            <div class="row align-items-center">
                <div class="col-lg-9">
                    <div id="brochure-preview-items" class="compare--grid compare--grid--scroll"></div>
                </div>
                <div class="col-lg-3 text-end mt-3 mt-lg-0">
                    <button class="btn btn--hover btn--pink" onclick="window.createBrochurePage()">
                        <span class="btn__text">สร้าง E-Brochure</span>
                    </button>
                    <button class="btn btn--hover btn--gray" onclick="clearAllBrochure()">
                        <span class="btn__text">ล้างตัวเลือก</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link href="~/vendors/sweetalert/sweetalert2.min.css" rel="stylesheet" />
    <style media="print">
        .section--banner,
        .sort-tool,
        .pagination,
        .compare-panel,
        #ai-tab,
        .search__tags,
        footer {
            display: none !important;
        }

        #asset-result-list {
            display: block !important;
        }
    </style>

    <style>
        #asset-result-list:has(.col-12) {
            display: block !important;
            /* เมื่อเจอ Empty State ให้ยกเลิกความเป็น Grid ของแม่ชั่วคราว */
        }
    </style>
}

@section Scripts {
    <script src="~/vendors/sweetalert/sweetalert2.all.min.js"></script>
    <script>
        // รับค่าจาก ViewBag
        // const SELECTED_TYPE_ID = parseInt("@ViewBag.AssetTypeId");
        // ข้อมูลจากระบบ Category เดิม
        window.SELECTED_TYPE_ID = @(ViewBag.AssetTypeId ?? "null");

        // ข้อมูลจากระบบ Search ใหม่
        window.SEARCH_PARAMS = {
        isSearchMode: @(ViewBag.IsSearchMode?.ToString().ToLower() ?? "false"),
        keyword: '@Html.Raw(ViewBag.Keyword)',
        types: '@ViewBag.Types',
        provinces: '@ViewBag.Provinces',
        minPrice: '@ViewBag.MinPrice',
        maxPrice: '@ViewBag.MaxPrice'
        };
    </script>
    <script type="module" src="~/js/features/search/search-handler.js"></script>
    <script type="module" src="~/js/features/compare/compare-service.js"></script>
    <script type="module" src="~/js/features/compare/brochure-service.js"></script>
    <script type="module" src="~/js/features/assets/asset-list.js"></script>
}