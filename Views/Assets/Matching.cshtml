                                    <button type="submit" class="btn btn--sam-pink">
                                        <span class="btn__text">ตกลง</span>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </section>

        @section Styles {
            <link href="~/vendors/sweetalert/sweetalert2.min.css" rel="stylesheet" />
        }

        @section Scripts {
            <script src="~/vendors/sweetalert/sweetalert2.all.min.js"></script>
            <script type="module" src="~/js/features/search/search-handler.js"></script>
            <script>
                document.addEventListener('DOMContentLoaded', function () {
                    const form = document.getElementById('appointmentForm');
                    @* const dateInput = document.getElementById('app_date'); *@
                                                    const phoneInput = document.getElementById('app_phone');
                    const emailInput = document.getElementById('app_email');
                    const clearBtn = document.querySelector('.btn--outline-white');

                    // 2. Format เบอร์โทรศัพท์ขณะพิมพ์
                    phoneInput.oninput = function () {
                        let value = this.value.replace(/\D/g, '');
                        if (value.length > 10) value = value.slice(0, 10);
                        
                        let formattedValue = '';
                        if (value.length > 0) {
                            formattedValue = value.substring(0, 3);
                            if (value.length > 3) formattedValue += '-' + value.substring(3, 6);
                            if (value.length > 6) formattedValue += '-' + value.substring(6, 10);
                        }
                        this.value = formattedValue;
                    };

                    // 3. ปุ่มล้างข้อมูล
                    clearBtn.addEventListener('click', function () {
                        form.reset();
                        fp.clear();
                    });

                    // 4. จัดการการ Submit (Validation + Success Alert)
                    form.onsubmit = function (e) {
                        e.preventDefault();

                        const phone = phoneInput.value.replace(/-/g, '');
                        const email = emailInput.value.trim();
                        const consent = form.querySelector('input[name="consent"]:checked');

                        // ตรวจสอบเบอร์โทร
                        if (phone.length < 10) {
                            showWarning('เบอร์โทรศัพท์ไม่ถูกต้อง', 'กรุณากรอกเบอร์โทรศัพท์ให้ครบ 10 หลัก');
                            return;
                        }

                        // ตรวจสอบ Email
                        const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                        if (email && !emailRegex.test(email)) {
                            showWarning('อีเมลไม่ถูกต้อง', 'กรุณากรอกรูปแบบอีเมลให้ถูกต้อง');
                            return;
                        }

                        // ตรวจสอบความยินยอม
                        if (!consent) {
                            showWarning('กรุณาเลือกความยินยอม', 'กรุณาเลือกว่ายินยอมหรือไม่ยินยอมให้เก็บข้อมูล');
                            return;
                        }

                        // แสดง Success (รวมฟังก์ชัน finishRegistration เดิมมาไว้ที่นี่)
                        Swal.fire({
                            width: '50%',
                            icon: 'success',
                            title: 'ขอบคุณสําหรับข้อมูลความต้องการของคุณ!',
                            text: 'บสส. ขออนุญาตทำการติดต่อกลับ เพื่อหาบ้านที่คุณมองหาตามความสนใจของคุณให้ดีที่สุด',
                            confirmButtonText: 'ตกลง',
                            confirmButtonColor: '#df9faa',
                            background: '#2c2c2c',
                            color: '#fff',
                            customClass: { confirmButton: 'rounded-pill px-4' }
                        }).then((result) => {
                            if (result.isConfirmed) {
                                window.location.href = '/';
                            }
                        });
                    };

                    function showWarning(title, text) {
                        Swal.fire({
                            icon: 'warning',
                            title: title,
                            text: text,
                            confirmButtonColor: '#df9faa'
                        });
                    }
                });
            </script>

            <script>
                document.addEventListener('DOMContentLoaded', function () {
                    const dropdownGroups = document.querySelectorAll('.search__select-group');

                    dropdownGroups.forEach(group => {
                        const items = group.querySelectorAll('.dropdown-item');
                        const buttonText = group.querySelector('button span');
                        const hiddenInput = group.querySelector('.dropdown-value-storage');

                        items.forEach(item => {
                            item.addEventListener('click', function (e) {
                                e.preventDefault();

                                // ดึงค่าจาก data-value หรือข้อความใน item
                                const selectedText = this.innerText;
                                const selectedValue = this.getAttribute('data-value') || selectedText;

                                // 1. อัปเดตหน้าตาปุ่ม
                                buttonText.innerText = selectedText;

                                // 2. อัปเดตค่าใน Hidden Input (เสมือนค่าของ <select>)
                                hiddenInput.value = selectedValue;

                                // 3. (Optional) ลบคลาส active จากตัวอื่นและเพิ่มให้ตัวที่เลือก
                                items.forEach(i => i.classList.remove('active'));
                                this.classList.add('active');

                                console.log(`Updated ${hiddenInput.name}: ${selectedValue}`);
                            });
                        });
                    });
                });
            </script>
        }