@{
    ViewData["Title"] = "หน้าหลัก | บริษัท บริหารสินทรัพย์สุขุมวิท จำกัด";
    ViewData["MetaDescription"] = "บริษัท บริหารสินทรัพย์สุขุมวิท จำกัด";
}

<section class="section section--banner">
    <div class="section__breadcrumb">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/home">หน้าแรก</a></li>
                <li class="breadcrumb-item active" aria-current="page">
                    <span>ร่วมงานกับเรา</span>
                </li>
            </ol>
        </nav>
    </div>

    <div class="container-fluid">
        <h1 class="page__title">
            ขั้นตอนการซื้อทรัพย์
        </h1>
    </div>
</section>

<section>
    <div class="section section--content section--vision bg-attachment-fixed" style="background-image:url(/media/images/bg/bg-process.jpg)">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-10 col-lg-6 mb-3 mb-lg-5">
                    <h2 class="page__title text-gradient text-gradient--green">
                        เป็นเจ้าของบ้านในฝัน...ง่ายกว่าที่คิด
                    </h2>
                    <p class="h4 font-weight-normal">
                        ขั้นตอนการซื้อทรัพย์สินรอการขาย (NPA) กับ SAM โปร่งใส ทุกขั้นตอน ตรวจสอบได้ พร้อมทีมงานมืออาชีพดูแลคุณจนถึงวันโอน
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="section section--content bg-light-gray py-5 py-lg-6">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12 mb-5">
                    <h3 class="page__title">
                        5 ขั้นตอน
                    </h3>
                    <h5>สู่ความเป็นเจ้าของบ้านในฝัน</h5>
                </div>

                <div class="col-12">
                    <div class="card-deck card-deck--cards-1 card-deck--cards-md-3 card-deck--cards-lg-5 grid--process">
                        <div class="grid--process-item">
                            <div class="grid--process-item__icon">
                                <i class="bi bi-search-heart"></i>
                            </div>
                            <h5>
                                01 ค้นหาและเลือกสรร
                            </h5>
                            <p>
                                ค้นหาทรัพย์ที่ถูกใจผ่านเว็บไซต์ หรือแอปพลิเคชัน SAM พร้อมตรวจสอบรายละเอียดเบื้องต้น
                            </p>
                        </div>
                        <div class="grid--process-item">
                            <div class="grid--process-item__icon">
                                <i class="bi bi-calendar3-week"></i>
                            </div>
                            <h5>
                                02 นัดชมทรัพย์จริง
                            </h5>
                            <p>
                                ติดต่อเจ้าหน้าที่เพื่อขอนัดเข้าชมสภาพ ทรัพย์สินจริง เพื่อความมั่นใจก่อน
                                ตัดสินใจซื้อ
                            </p>
                        </div>
                        <div class="grid--process-item">
                            <div class="grid--process-item__icon">
                                <i class="bi bi-pen"></i>
                            </div>
                            <h5>
                                03 ยื่นคำเสนอซื้อ
                            </h5>
                            <p>
                                กรอกแบบฟอร์มคำเสนอซื้อ พร้อมวาง เงินประกันซอง (ตามเงื่อนไขที่กำหนด) เพื่อเข้าสู่กระบวนการพิจารณา
                            </p>
                        </div>
                        <div class="grid--process-item">
                            <div class="grid--process-item__icon">
                                <i class="bi bi-hand-thumbs-up"></i>
                            </div>
                            <h5>
                                04 แจ้งผลและทำสัญญา
                            </h5>
                            <p>
                                เมื่อได้รับการอนุมัติ SAM จะนัดหมายเพื่อทำสัญญาจะซื้อจะขาย ภายในระยะเวลาที่กำหนด
                            </p>
                        </div>
                        <div class="grid--process-item">
                            <div class="grid--process-item__icon">
                                <i class="bi bi-key"></i>
                            </div>
                            <h5>
                                05 โอนกรรมสิทธิ์
                            </h5>
                            <p>
                                ชำระเงินส่วนที่เหลือ และนัดหมายโอน กรรมสิทธิ์ ณ สำนักงานที่ดิน...
                                ยินดีด้วย! คุณคือเจ้าของคนใหม่
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="section section--content py-5 py-lg-6">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <h3>
                        เอกสารที่ต้องเตรียม
                    </h3>
                </div>

                <div class="col-12 col-md-6">
                    <hr />
                    <div class="ck-content">
                        <h5>
                            สำหรับบุคคลธรรมดา
                        </h5>
                        <ul class="list-unstyled">
                            <li>1. สำเนาบัตรประชาชน (พร้อมรับรองสำเนาถูกต้อง)</li>
                            <li>2. สำเนาทะเบียนบ้าน</li>
                            <li>3. สำเนาทะเบียนสมรส / ใบเปลี่ยนชื่อ-สกุล (ถ้ามี)</li>
                            <li>4. สลิปโอนเงินประกันซอง</li>
                        </ul>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <hr />
                    <div class="ck-content">
                        <h5>
                            สำหรับนิติบุคคล
                        </h5>
                        <ul class="list-unstyled">
                            <li>1. สำเนาหนังสือรับรองบริษัท (ไม่เกิน 3 เดือน)</li>
                            <li>2. สำเนาบัตรประชาชนกรรมการผู้มีอำนาจ</li>
                            <li>3. สำเนาภพ.20 (ถ้ามี)</li>
                            <li>4. รายงานการประชุมคณะกรรมการที่มีมติให้ซื้อทรัพย์</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="section section--content section--vision bg-attachment-fixed" style="background-image:url(/media/images/bg/bg-why.jpg)">
        <div class="container-fluid">
            <div class="row">
                <div class="col-lg-12 mb-3 mb-lg-5">
                    <h2 class="page__title text-gradient text-gradient--green">
                        ทำไมถึงควรเลือกซื้อกับ SAM?
                    </h2>
                </div>

                <div class="col-lg-12">
                    <div class="card-deck card-deck--cards-1 card-deck--cards-md-3">
                        <div class="card card--mission py-5">
                            <h3 class="card__title">
                                ถูกต้องตามกฎหมาย
                            </h3>
                            <p class="card__text">ทรัพย์สินทุกรายการผ่านกระบวนการทางกฎหมาย ตรวจสอบที่มาได้ 100%</p>
                        </div>

                        <div class="card card--mission py-5">
                            <h3 class="card__title">
                                ราคาคุ้มค่า
                            </h3>
                            <p class="card__text">ราคาเข้าถึงง่าย เหมาะสำหรับทั้งอยู่อาศัยเองและเพื่อการลงทุน</p>
                        </div>

                        <div class="card card--mission py-5">
                            <h3 class="card__title">
                                ทำเลศักยภาพ
                            </h3>
                            <p class="card__text">มีทรัพย์หลากหลายประเภท ครอบคลุมทุกทำเลทั่วประเทศไทย</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="section section--content py-5 py-lg-6">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <h3>
                        คำถามที่พบบ่อย
                    </h3>
                </div>

                <div class="col-12">
                    <div class="accordion accordion--faq" id="accordionFAQs">
                        <div class="accordion--item">
                            <div data-bs-toggle="collapse" data-bs-target="#faq-1" aria-expanded="true" aria-controls="faq-1" class="accordion__header">
                                <h4 class="accordion__title">
                                    กู้ไม่ผ่าน คืนเงินมัดจำไหม?
                                </h4>
                                <div class="accordion__right">
                                    <span class="accordion__icon">
                                        <em class=" bi bi-chevron-down"></em>
                                    </span>
                                </div>
                            </div>
                            <div id="faq-1" class="accordion-collapse collapse show" aria-labelledby="faq-1" data-bs-parent="#accordionFAQs">
                                <div class="accordion__content ck-content">
                                    <p>
                                        หากผู้ซื้อยื่นขอสินเชื่อกับสถาบันการเงินแล้วไม่ผ่านการอนุมัติ ผู้ซื้อสามารถขอคืนเงินมัดจำได้เต็มจำนวน โดยติดต่อเจ้าหน้าที่ของ SAM พร้อมแสดงหลักฐานการยื่นขอสินเชื่อและผลการพิจารณาจากสถาบันการเงิน
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="accordion--item">
                            <div data-bs-toggle="collapse" data-bs-target="#faq-2" aria-expanded="false" aria-controls="faq-2" class="accordion__header">
                                <h4 class="accordion__title">
                                    ค่าโอนกรรมสิทธิ์ ใครเป็นคนจ่าย?
                                </h4>
                                <span class="accordion__icon">
                                    <em class=" bi bi-chevron-down"></em>
                                </span>
                            </div>
                            <div id="faq-2" class="accordion-collapse collapse" aria-labelledby="faq-2" data-bs-parent="#accordionFAQs">
                                <div class="accordion__content ck-content">
                                    <p>
                                        ค่าโอนกรรมสิทธิ์จะถูกแบ่งออกเป็นสองส่วน คือส่วนของผู้ขายและผู้ซื้อ โดยทั่วไปแล้ว ผู้ขายจะรับผิดชอบค่าโอนในส่วนของตนเอง ส่วนผู้ซื้อจะรับผิดชอบค่าโอนในส่วนของตนเอง อย่างไรก็ตาม ในบางกรณีอาจมีการตกลงกันระหว่างผู้ซื้อและผู้ขายให้ฝ่ายใดฝ่ายหนึ่งรับผิดชอบค่าโอนทั้งหมด หรือแบ่งกันตามสัดส่วนที่ตกลงกันไว้
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="section section--content bg-gradient-yellow py-5 py-lg-6">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <h3>
                        พร้อมมองหาโอกาสใหม่หรือยัง?
                    </h3>
                </div>
                <div class="col-12">
                    <a href="/npa/search-results" class="btn btn--hover btn--green">
                        <span class="btn__text">ค้นหาทรัพย์ NPA</span>
                        <span class="btn__icon"><svg class="icon"><use xlink:href="#icon-arrow-explore"></use></svg></span>
                    </a>

                    <a href="/npa/download" class="btn btn--hover btn--pink">
                        <span class="btn__text">ดาวน์โหลดแบบฟอร์ม</span>
                        <span class="btn__icon"><svg class="icon"><use xlink:href="#icon-arrow-explore"></use></svg></span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>