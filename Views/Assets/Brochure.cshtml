@{
    ViewData["Title"] = "E-Brochure | บริษัท บริหารสินทรัพย์สุขุมวิท จำกัด";
    ViewData["MetaDescription"] = "บริษัท บริหารสินทรัพย์สุขุมวิท จำกัด";
}

<div class="brochure">
    @* แถบเครื่องมือ (ไม่พิมพ์ออกกระดาษ) *@
    <div class="brochure__toolbar">
        <button class="btn btn--sam-green" onclick="savePdf()">
            <span class="btn__icon"><i class="bi bi-file-earmark-pdf"></i></span>
            <span class="btn__text">บันทึก PDF / พิมพ์</span>
        </button>
    </div>

    @* ===== หน้าปก: 3 layers (ภาพตึก + พื้นเขียว + พื้นขาว) ===== *@
    <section class="brochure__page brochure__cover">
        <div class="brochure-cover__photo"></div>
        <div class="brochure-cover__green"></div>
        @* <div class="brochure-cover__white"></div> *@

        <div class="brochure-cover__content">
            <img class="brochure-cover__logo" src="~/media/images/logo/logo-main.webp" alt="SAM" />

            <h1 class="brochure-cover__title">
                ทรัพย์มือสอง<br>ต้อง <span>SAM</span>
            </h1>

            <div class="brochure-cover__section">
                <h3 class="brochure-cover__heading">ประเภททรัพย์</h3>
                <ul class="brochure-cover__list" id="brochure-types"></ul>
            </div>

            <div class="brochure-cover__section">
                <h3 class="brochure-cover__heading">ทำเล</h3>
                <ul class="brochure-cover__list" id="brochure-locations"></ul>
            </div>
        </div>

        <div class="brochure-foot brochure-foot--cover">
            <div class="brochure-foot__contact">
                <span class="brochure-foot__item"><i class="bi bi-telephone-fill"></i> 1443</span>
                <span class="brochure-foot__item"><i class="bi bi-globe"></i> www.sam.or.th</span>
                <span class="brochure-foot__item"><i class="bi bi-line"></i> @@samline</span>
                <img class="brochure-foot__qr" src="~/media/images/sample-qrcode.jpg" alt="QR">
            </div>
            <span class="brochure-foot__note">*เงื่อนไขเป็นไปตามที่ บสส. กำหนด</span>
        </div>
    </section>

    @* ===== หน้าเนื้อหา: JS เติมตามทำเล/จังหวัด ===== *@
    <div id="brochure-pages">
        <div class="text-center py-5">
            <div class="spinner-border text-pink" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2">กำลังเตรียมข้อมูลโบรชัวร์...</p>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .header,
        .footer {
            display: none;
        }
    </style>
}

@section Scripts {
    <script src="~/vendors/sweetalert/sweetalert2.all.min.js"></script>
    <script src="~/js/data/data.js" type="module"></script>
    <script src="~/js/features/compare/brochure-service.js" type="module"></script>
    <script src="~/js/features/compare/e-brochure.js" type="module"></script>
    <script>
        // แนะนำผู้ใช้ให้บันทึกเป็น PDF ผ่านหน้าต่างพิมพ์ของเบราว์เซอร์ แล้วค่อยเปิด print dialog
        function savePdf() {
            let confirmed = false;
            Swal.fire({
                icon: 'info',
                title: 'บันทึกเป็น PDF',
                html: 'ในหน้าต่างถัดไป ให้เลือกช่อง <b>ปลายทาง (Destination)</b> เป็น <b>“Save as PDF”</b> แล้วกด <b>Save</b><br><span class="text-muted small">* เปิด “Background graphics” ด้วย เพื่อให้สีและรูปครบ</span>',
                confirmButtonText: 'ดำเนินการต่อ',
                confirmButtonColor: '#286140',
                allowOutsideClick: false,
                preConfirm: () => { confirmed = true; },
                // รอให้ modal ปิดสนิทก่อน ค่อยเปิดหน้าต่างพิมพ์ (กัน backdrop ค้างจน print ไม่ทำงาน)
                didClose: () => {
                    if (confirmed) setTimeout(() => window.print(), 200);
                }
            });
        }
    </script>
}
