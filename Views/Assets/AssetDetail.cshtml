<section class="asset-detail asset-detail--first">
    <div class="container">
        <div class="asset-gallery">
            @{
                // รายการรูปทั้งหมดของทรัพย์สิน (ในงานจริงดึงจาก Model)
                var galleryImages = new[]
                {
                    "/media/images/gallery/sample-01.jpg",
                    "/media/images/gallery/sample-02.jpg",
                    "/media/images/gallery/sample-03.jpg",
                    "/media/images/gallery/sample-04.jpg",
                    "/media/images/gallery/sample-05.jpg",
                    "/media/images/gallery/sample-06.jpg",
                    "/media/images/gallery/sample-07.jpg",
                };
                const int visibleCount = 5; // จำนวนช่องที่แสดงในกริด (1 featured + 2x2)
                var hiddenCount = galleryImages.Length - visibleCount;
            }

            <div id="lightgallery" class="asset-gallery__grid">
                @for (var i = 0; i < galleryImages.Length; i++)
                {
                    var src = galleryImages[i];
                    var isFeatured = i == 0;
                    var isMoreTile = i == visibleCount - 1 && hiddenCount > 0;
                    var isHidden = i >= visibleCount;

                    var itemClass = "asset-gallery__item";
                    if (isFeatured) { itemClass += " asset-gallery__item--featured"; }
                    if (isMoreTile) { itemClass += " asset-gallery__item--more"; }
                    if (isHidden) { itemClass += " asset-gallery__item--hidden"; }

                    <a href="@src" class="@itemClass" data-sub-html="รูปที่ @(i + 1) / @galleryImages.Length">
                        <img src="@src" alt="รูปทรัพย์สินที่ @(i + 1)" loading="lazy">

                        @if (isMoreTile)
                        {
                            <span class="asset-gallery__overlay">
                                <span class="asset-gallery__overlay-text">ดูรูปทั้งหมด</span>
                                <span class="asset-gallery__overlay-count">+@hiddenCount</span>
                            </span>
                        }
                    </a>
                }
            </div>

            @* <div class="small mt-2">ภาพใช้เพื่อการโฆษณา กรุณาเข้าดูสภาพทรัพย์จริงก่อนตัดสินใจซื้อ</div> *@
        </div>

        <div class="asset-search" data-bs-toggle="offcanvas" data-bs-target="#advancedSearch">
            <span class="asset-search__text">
                <span class="asset-search__icon">
                    <img src="/media/images/icon-search.png" />
                </span>
            </span>
            <span class="asset-search__text">
                ค้นหาทรัพย์
            </span>
        </div>

        <div class="asset-action">
            <a href="/yourdesign" class="btn btn--sam-green">
                <span class="btn__text">
                    <span class="btn__icon"><i class="bi bi-vector-pen"></i></span>
                </span>
                <span class="btn__text">
                    ออกแบบบ้านด้วยตัวเอง
                </span>
            </a>

            <a href="#booking-section" class="btn btn--sam-pink btn-booking-top">
                <span class="btn__text">
                    <span class="btn__icon"><i class="bi bi-printer"></i></span>
                </span>
                <span class="btn__text">
                    พิมพ์โบรชัวร์
                </span>
            </a>

            <button class="btn btn--sam-gray">
                <span class="btn__icon">
                    <i class="bi bi-printer"></i>
                </span>
                <span class="btn__text">
                    พิมพ์หน้านี้
                </span>
            </button>
            <button class="btn btn--sam-gray" id="btn-share-main" style="min-width: 40px; width: 40px; height: 40px;">
                <span class="btn__icon">
                    <svg class="icon">
                        <use xlink:href="#icon-share"></use>
                    </svg>
                </span>
            </button>
        </div>

        <div id="share-popover-content" style="display: none;">
            <div class="share-options">
                <a href="javascript:void(0)" class="share-btn share-btn--facebook" onclick="shareTo('facebook')">
                    <img src="~/media/images/social/icon-facebook.png" />
                </a>
                <a href="javascript:void(0)" class="share-btn share-btn--line" onclick="shareTo('line')">
                    <img src="~/media/images/social/icon-line.png" />
                </a>
                <a href="javascript:void(0)" class="share-btn share-btn--x" onclick="shareTo('x')">
                    <img src="~/media/images/social/icon-twitter.png" />
                </a>
                <a href="javascript:void(0)" class="share-btn share-btn--mail" onclick="shareTo('email')">
                    <img src="~/media/images/social/icon-mail.png" />
                </a>
                <div class="share-divider"></div>
                <button class="share-copy-link" onclick="copyToClipboard(this)">
                    <span class="copy-text">คัดลอกลิงก์</span>
                    <i class="bi bi-link-45deg"></i>
                </button>
            </div>
        </div>
    </div>
</section>

