                                    <span class="btn__text">
                                        ล้างข้อมูล
                                    </span>
                                </button>
                                <button type="submit" class="btn btn--sam-pink">
                                    <span class="btn__text">
                                        ทำรายการนัดชม
                                    </span>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

