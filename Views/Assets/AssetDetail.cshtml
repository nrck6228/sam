<section id="loan-calculator-section" class="loan-calculator">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h2 class="section-title mb-4">คำนวณสินเชื่อโดยประมาณ</h2>
            </div>
            <div class="col-lg-6">
                <div class="calculator-card h-100">
                    <div class="form form--dark h-100">
                        <div class="mb-3">
                            <label class="text-white-50 small">ราคาทรัพย์สิน (บาท)</label>
                            <div class="form-group">
                                <input type="number" id="loan_asset_price" class="form-control" readonly>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="text-white-50 small">วงเงินกู้ที่ต้องการ (บาท)</label>
                            <div class="form-group">
                                <input type="number" id="loan_amount" class="form-control" placeholder="ระบุจำนวนเงิน">
                            </div>
                        </div>


                        <div class="row">
                            <div class="col-6 mb-3">
                                <label class="text-white-50 small">อัตราดอกเบี้ย (%)</label>
                                <div class="form-group">
                                    <input type="number" id="loan_interest" class="form-control" value="3.0" step="0.1">
                                </div>
                            </div>
                            <div class="col-6 mb-3">
                                <label class="text-white-50 small">ระยะเวลากู้ (ปี)</label>
                                <div class="form-group">
                                    <input type="number" id="loan_years" class="form-control" value="30">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12 my-4">
                                <button type="button" class="btn btn--sam-pink btn-calculate-loan">
                                    <span class="btn__text">
                                        คำนวณสินเชื่อ
                                    </span>
                                </button>
                            </div>
                        </div>

                        <p class="text-white-50 small m-0">
                            * เป็นการคำนวณเบื้องต้นเท่านั้น เงื่อนไขเป็นไปตามที่ธนาคารกำหนด
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="result-card shadow-sm h-100">
                    <div class="mb-4">
                        <h5 class="result-card__title">รายละเอียดสินเชื่อ</h5>
                        <div class="d-flex justify-content-between align-items-end mt-3">
                            <span class="result-card__label">ยอดสินเชื่อที่ต้องชำระต่อเดือนโดยประมาณ</span>
                            <span class="result-card__value"><span id="res_monthly_pay">0</span> บาท / เดือน</span>
                        </div>

                        <div class="mt-2">
                            <div class="progress" style="height: 12px; border-radius: 10px; background-color: #286140;">
                                <div id="bar_principal" class="progress-bar"
                                     style="width: 0%; background-color: #df9faa; transition: width 0.5s ease;"></div>
                            </div>
                            <div class="d-flex justify-content-between mt-2">
                                <span class="small"><i class="bi bi-circle-fill me-1" style="color: #df9faa"></i>
                                    เงินต้น <span id="res_principal_val">0</span> บาท (<span
                                    id="res_principal_percent">0</span>%)</span>
                                    <span class="small"><i class="bi bi-circle-fill me-1" style="color: #286140"></i>
                                        ดอกเบี้ย <span id="res_interest_val">0</span> บาท (<span
                                        id="res_interest_percent">0</span>%)</span>
                                    </div>
                                </div>
                            </div>

                            <hr>

                            <div class="mt-4">
                                <h5 class="result-card__title">ค่าใช้จ่ายที่อาจต้องมีเบื้องต้น</h5>
                                <div class="d-flex justify-content-between align-items-end mt-3">
                                    <span class="result-card__label">เงินดาวน์ทั้งหมด</span>
                                    <span class="result-card__value"><span id="res_down_payment">0</span> บาท</span>
                                </div>

                                <div class="mt-2">
                                    <div class="progress" style="height: 12px; border-radius: 10px; background-color: #286140;">
                                        <div id="bar_down" class="progress-bar"
                                             style="width: 0%; background-color: #df9faa; transition: width 0.5s ease;"></div>
                                    </div>
                                    <div class="d-flex justify-content-between mt-2">
                                        <span class="small"><i class="bi bi-circle-fill me-1" style="color: #df9faa"></i>
                                            เงินดาวน์ <span id="res_down_percent">0</span>%</span>
                                            <span class="small"><i class="bi bi-circle-fill me-1" style="color: #286140"></i>
                                                จำนวนสินเชื่อ <span id="res_loan_val">0</span> บาท ในอัตรา <span
                                                id="res_loan_percent">0</span>% ของราคาบ้าน</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="related-section">
                    <div class="container">
                        <div class="section-header">
                            <h2 class="text-dark">ทรัพย์สินใกล้เคียงที่น่าสนใจ</h2>
                            <a href="/npa/search-results" title="" class="btn btn--hover btn--gray">
                                <span class="btn__text">ดูทั้งหมด</span>
                                <span class="btn__icon"><svg class="icon">
                                    <use xlink:href="#icon-arrow-explore"></use>
                                </svg></span>
                            </a>
                        </div>

                        <div class="row g-4" id="related-assets-grid">
                        </div>
                    </div>
                </section>

                @section Styles {
                    <link rel="stylesheet" href="https://unpkg.com/tippy.js@6/dist/tippy.css" />
                    <link href="~/vendors/sweetalert/sweetalert2.min.css" rel="stylesheet" />
                    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
                    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/dark.css">
                    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lightgallery@2.8.3/css/lightgallery-bundle.min.css" />

                    <style>
                        .swiper-notification {
                            pointer-events: none;
                        }
                    </style>
                }

                @section Scripts {
                    <script src="https://unpkg.com/@@popperjs/core@@2"></script>
                    <script src="https://unpkg.com/tippy.js@@6"></script>
                    <script src="~/vendors/sweetalert/sweetalert2.all.min.js"></script>
                    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
                    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/th.js"></script>
                    <script src="https://cdn.jsdelivr.net/npm/lightgallery@2.8.3/lightgallery.min.js"></script>
                    <script src="https://cdn.jsdelivr.net/npm/lightgallery@2.8.3/plugins/zoom/lg-zoom.min.js"></script>
                    <script src="https://cdn.jsdelivr.net/npm/lightgallery@2.8.3/plugins/thumbnail/lg-thumbnail.min.js"></script>
                    <script>
                        document.addEventListener('DOMContentLoaded', () => {

                        lightGallery(
                        document.getElementById('lightgallery'),
                        {
                        speed: 500,
                        download: false,
                        counter: true,
                        thumbnail: true,
                        plugins: [
                        lgZoom,
                        lgThumbnail
                        ]
                        }
                        );

                        });
                    </script>
                    <script>
                        // รับค่ารหัสทรัพย์สินจาก ViewBag
                        const SELECTED_ASSET_CODE = "@ViewBag.AssetCode";
                    </script>
                    <script type="module" src="~/js/features/assets/asset-detail.js"></script>
                    <script type="module" src="~/js/features/search/search-handler.js"></script>
                    <script type="module" src="~/js/shared/share.util.js"></script>
                }