@using sam.Models
@model List<PromotionViewModel>
@{
    ViewData["Title"] = "หน้าหลัก | บริษัท บริหารสินทรัพย์สุขุมวิท จำกัด";
    ViewData["MetaDescription"] = "บริษัท บริหารสินทรัพย์สุขุมวิท จำกัด";
}

<section class="section section--banner">
    <div class="section__breadcrumb">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <span>ทรัพย์สินรอการขาย</span>
                </li>
                <li class="breadcrumb-item active">
                    <span>โปรโมชั่นทรัพย์เด่น</span>
                </li>
            </ol>
        </nav>
    </div>

    <div class="container-fluid">
        <h1 class="page__title">
            โปรโมชั่นทรัพย์เด่น
        </h1>
    </div>
</section>

<section>
    <div class="section section--content section--promotion">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div id="promotion-container" class="card-deck card-deck--cards-lg-3">
                    </div>

                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center pagination--primary" id="promotion-pagination">
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</section>

@section Styles {
}
@section Scripts {
    <script type="module" src="~/js/features/content/promotion.js"></script>
    <script>
        $(document).on('click', '.page-link', function (e) {
        e.preventDefault();
        if ($(this).parent().hasClass('disabled') || $(this).parent().hasClass('active')) return;

        const href = $(this).attr('href');
        const segments = href.split('/');
        const page = parseInt(segments[segments.length - 1]);

        // 1. สั่งจางลง (Opacity -> 0)
        $('#promotion-container').stop().animate({ opacity: 0 }, 200, function () {

        // 2. เรียกฟังก์ชัน Render ใหม่ (ต้องชื่อเดียวกับที่ผูกในไฟล์ JS)
        if (typeof window.renderContent === 'function') {
        window.renderContent(page);
        }

        // 3. สั่งแสดงผลกลับมา (Opacity -> 1)
        $(this).animate({ opacity: 1 }, 200);
        });

        // เลื่อนหน้าจอกลับขึ้นไปด้านบน
        $('html, body').stop().animate({
        scrollTop: $("#promotion-container").offset().top - 120
        }, 600);

        window.history.pushState({ page: page }, '', href);
        });
    </script>
}