@using sam.Models
@model List<AnnualReportViewModel>
@{
    ViewData["Title"] = "หน้าหลัก | บริษัท บริหารสินทรัพย์สุขุมวิท จำกัด";
    ViewData["MetaDescription"] = "บริษัท บริหารสินทรัพย์สุขุมวิท จำกัด";
}

<section class="section section--banner">
    <div class="section__breadcrumb">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <span>ทรัพย์สินรอการขาย</span>
                </li>
                <li class="breadcrumb-item active">
                    <span>ประเภททรัพย์สิน</span>
                </li>
            </ol>
        </nav>
    </div>

    <div class="container-fluid">
        <h1 class="page__title">
            ประเภททรัพย์สิน
        </h1>
    </div>
</section>

<section>
    <div class="section section--content section--assets bg-attachment-fixed"
         style="background-image:url(/media/images/bg/bg-categories.jpg)">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <form class="form form--filter">
                        <div class="row">
                            <div class="col-md-4 col-lg-3">
                                <div class="form-group border-0">
                                    <div class="search">
                                        <input type="text" class="search__input" name="keyword" id="keyword"
                                               maxlength="100" autocomplete="off" placeholder="คำค้นหา">
                                        <button class="search__icon" type="submit">
                                            <svg class="icon">
                                                <use xlink:href="#icon-search"></use>
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div id="asset-type" class="card-deck card-deck--cards-1 card-deck--cards-md-2 card-deck--cards-lg-4">
            </div>
        </div>
    </div>
</section>

@section Styles {
}
@section Scripts {
    <script type="module" src="~/js/features/assets/asset-category.js"></script>
}