@section Styles {
    <style>
        .table--survey thead th {
            background-color: #1d543a;
            /* สีเขียว SAM */
            color: white;
            border: none;
            padding: 15px;
        }

        .table--survey tbody td {
            padding: 15px;
            vertical-align: middle;
            border-bottom: 1px solid #eee;
        }

        .table--survey tbody tr:hover {
            background-color: #f9f9f9;
        }

        /* ปรับแต่ง Radio Button ให้ดูใหญ่ขึ้น */
        input[type="radio"] {
            width: 20px;
            height: 20px;
            cursor: pointer;
        }

        .btn--sam-pink {
            background-color: #df9faa;
            color: white;
            border-radius: 30px;
            border: none;
            transition: 0.3s;
        }

        .btn--sam-pink:hover {
            background-color: #c98a95;
            transform: translateY(-2px);
        }
    </style>
}
@section Scripts {
    <script type="module" src="~/js/features/home/survey.js"></script>
}