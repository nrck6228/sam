<section class="home home--project home-wrapper">
    <div class="container-fluid">
        <div class="home__header">
            <h2 class="home__title text-gradient text-gradient--green">
                ปิดหนี้ไว ไปต่อได้
            </h2>
        </div>

        <div class="home__body">
            <p>
                หนี้ครัวเรือนเป็นปัญหาเชิงโครงสร้างสำคัญที่ส่งผลกระทบต่อความเป็นอยู่ที่ดีของประชาชนและการเติบโตทางเศรษฐกิจของไทย
                ซึ่งภาครัฐและ ธปท. ได้ร่วมกันผลักดันแนวทางแก้ไขอย่างต่อเนื่อง อย่างไรก็ตาม
                ภายใต้สถานการณ์ปัจจุบันที่รายได้ของครัวเรือนยังฟื้นตัวช้า
                ทำให้ยังมีปัญหาการชำระหนี้และกลายเป็นหนี้เสียเพิ่มขึ้น โครงการ “ปิดหนี้ไว
                ไปต่อได้” จึงเป็นมาตรการเฉพาะกิจ ที่จะดำเนินการเพียงครั้งเดียว มุ่งเน้นช่วยเหลือลูกหนี้รายย่อยที่เป็น
                NPLs ให้ได้รับการปรับโครงสร้างหนี้เพื่อลดภาระหนี้ ปิดจบหนี้ได้เร็ว
                และกลับมามีประวัติการชำระหนี้ที่ดีขึ้น 
            </p>
        </div>

        <div class="reveal-on-scroll">
            <div class="card-deck card-deck--cards-1 card-deck--cards-lg-2">
                <div class="card card--stats">
                    <div class="card--stats__number">
                        100<span>%</span>
                    </div>
                    <div class="card--stats__label">
                        หยุดดอกเบี้ยถาวร
                    </div>
                </div>

                <div class="card card--stats">
                    <div class="card--stats__number">
                        3<span>ปี</span>
                    </div>
                    <div class="card--stats__label">
                        ระยะเวลาโครงการ
                    </div>
                </div>
            </div>
        </div>

        <div class="home__btn">
            <a href="/" title="" class="btn btn--hover btn--green">
                <span class="btn__text">ลงทะเบียน</span>
                <span class="btn__icon"><svg class="icon">
                    <use xlink:href="#icon-arrow-explore"></use>
                </svg></span>
            </a>
            <a href="/" title="" class="btn btn--hover btn--pink">
                <span class="btn__text">ติดต่อสอบถาม</span>
                <span class="btn__icon">
                    <svg class="icon">
                        <use xlink:href="#icon-arrow-explore"></use>
                    </svg>
                </span>
            </a>
            <a href="/" title="" class="btn btn--hover btn--gray">
                <span class="btn__text">สายด่วน</span>
                <span class="btn__icon">
                    <svg class="icon">
                        <use xlink:href="#icon-arrow-explore"></use>
                    </svg>
                </span>
            </a>
        </div>
    </div>
</section>

