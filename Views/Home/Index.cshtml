    ViewData["MetaDescription"] = "บริษัท บริหารสินทรัพย์สุขุมวิท จำกัด";
}

<section class="home home--banner">
    <div class="home__slide">
        <div class="swiper swiper--home">
            <div class="swiper-wrapper">
                <!-- Render from home.js -->
            </div>

            <!-- Controls -->
            <div class="swiper--home__controls">
                <div class="swiper--home__pagination"></div>
            </div>

            <div class="swiper--home__scroll">
                Scroll
            </div>
        </div>
    </div>

    <div class="home__search">
        <div class="container">
            <partial name="_SearchPanel" />
        </div>
    </div>

    <div class="home__nav">
        <div class="home__nav__group">
            <a href="/npa/asset-matching" title="" class="btn btn--xl btn--green btn--hover">
                <span class="btn__text">จับคู่ทรัพย์สิน NPA</span>
                <span class="btn__icon"><svg class="icon">
                    <use xlink:href="#icon-arrow-explore"></use>
                </svg></span>
            </a>
            <a href="/npa/legal-execution" title="" class="btn btn--xl btn--green btn--hover">
                <span class="btn__text">ทรัพย์ขายทอดตลาดกรมบังคับคดี</span>
                <span class="btn__icon"><svg class="icon">
                    <use xlink:href="#icon-arrow-explore"></use>
                </svg></span>
            </a>
        </div>
    </div>
</section>

<section class="home home--highlight">
    <div class="container-fluid">
        <div class="row align-items-end">
            <div class="col-lg-8">
                <div class="home__header">
                    <h2 class="home__title text-gradient text-gradient--green">
                        SAM ใส่ใจ
                    </h2>
                    @* <img src="~/media/images/mascot.png" class="d-none d-md-block d-lg-none w-25" /> *@
                </div>

                <div class="home__body">
                    <p class="mb-0">
                        ทรัพย์สินที่ถูกเสนอขายหรือแนะนำให้ซื้อ โดยเฉพาะอย่างยิ่ง "ทรัพย์ NPA" (Non-Performing Asset)
                        ซึ่งเป็นทรัพย์สินที่ธนาคารหรือสถาบันการเงินถือครองอยู่และนำมาขายในราคาพิเศษ มักเป็นบ้านมือสอง
                        หรือที่ดินเปล่า ที่เคยเป็นหลักประกันและหลุดจำนอง หรือถูกตีโอนชำระหนี้
                    </p>
                </div>

                <nav class="highlight reveal-on-scroll">
                    <div id="highlight-grid" class="highlight__grid"></div>
                </nav>
            </div>

            <div class="col-lg-4">
                <img src="~/media/images/mascot.png" class="d-none d-lg-block img-fluid mx-auto" />
            </div>
        </div>
    </div>
</section>

